{%- comment -%}
  Reproduces the official page's closing black professional-CTA band: two
  equal columns (salon-acquisition copy+button / salon-locator copy+button)
  separated by a single thin center divider line — a vertical hairline on
  desktop, a horizontal one between the stacked blocks on mobile. Horizon's
  generic "group" block only exposes a 4-side border (a box around one
  side, not a single shared line between both), so this is a small bespoke
  section with the divider drawn as a pseudo-element instead, matching the
  same "own section for a composition no native block produces" pattern
  already used for montibello-feature-rows/montibello-stats-panel.
{%- endcomment -%}

<div
  class="section section--{{ section.settings.section_width }} montibello-pro-cta spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}background-color:{{ section.settings.background_color | default: '#000000' }};"
>
  <div class="montibello-pro-cta__row">
    <div class="montibello-pro-cta__col">
      <p class="montibello-pro-cta__text">{{ section.settings.left_text }}</p>
      {% if section.settings.left_button_label != blank %}
        <a href="{{ section.settings.left_button_link | default: '#' }}" class="montibello-pro-cta__button">
          {{ section.settings.left_button_label }}
        </a>
      {% endif %}
    </div>

    <div class="montibello-pro-cta__col">
      <p class="montibello-pro-cta__text">{{ section.settings.right_text }}</p>
      {% if section.settings.right_button_label != blank %}
        <a href="{{ section.settings.right_button_link | default: '#' }}" class="montibello-pro-cta__button">
          {{ section.settings.right_button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .montibello-pro-cta {
    color: #FFFFFF;

    /* the stacked mobile row overshoots the viewport by <1px, which showed
       up as a 1px horizontal scroll on every page carrying this band */
    @media screen and (max-width: 749px) {
      overflow-x: clip;
    }
  }

  .montibello-pro-cta__row {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 1300px;
    margin-inline: auto;
    padding-inline: 30px;

    @media screen and (min-width: 750px) {
      flex-direction: row;
      align-items: center;
      gap: 40px;
    }
  }

  /* Single shared divider line — a horizontal rule between the stacked
     columns on mobile, a vertical rule centered between them on desktop.
     A pseudo-element on the row (not a border on either column) is what
     keeps this to exactly one line instead of a box around one side. */
  .montibello-pro-cta__row::after {
    content: '';
    position: absolute;
    background: rgba(255, 255, 255, 0.35);
    left: 0;
    right: 0;
    height: 1px;
    top: 50%;
    transform: translateY(-50%);

    @media screen and (min-width: 750px) {
      left: 50%;
      right: auto;
      top: 0;
      bottom: 0;
      width: 1px;
      height: auto;
      transform: translateX(-50%);
    }
  }

  .montibello-pro-cta__col {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex: 1 1 0;

    @media screen and (max-width: 749px) {
      flex-direction: column;
      align-items: flex-start;
      padding-block: 20px;
    }
  }

  .montibello-pro-cta__col:first-child {
    @media screen and (max-width: 749px) {
      padding-top: 0;
    }
  }

  .montibello-pro-cta__col:last-child {
    @media screen and (max-width: 749px) {
      padding-bottom: 0;
    }
  }

  .montibello-pro-cta__text {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }

  .montibello-pro-cta__button {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border: 1px solid #FFFFFF;
    color: #FFFFFF;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .montibello-pro-cta__button:hover {
    background-color: #FFFFFF;
    color: #000000;
  }

  /* FULL-SITE PARITY (official band, 1440): 202px black band, two 650px
     columns on the 1300px container, copy 23/21/700 (-2%) stacked 20px above
     a 40px outlined 18px/38px uppercase button (radius 5), the right column
     inset 55px, one hairline between the columns. */
  @media screen and (min-width: 750px) {
    .montibello-pro-cta {
      padding-block: 50px !important;
    }

    .montibello-pro-cta__row {
      width: 100%;
      align-items: stretch;
      gap: 0;
      padding-inline: 0;
    }

    .montibello-pro-cta__col {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 20px;
      flex: 0 0 50%;
    }

    .montibello-pro-cta__col + .montibello-pro-cta__col {
      padding-inline-start: 55px;
    }

    .montibello-pro-cta__text {
      max-width: 300px;
      font-size: 23px;
      line-height: 21px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .montibello-pro-cta__button {
      height: 40px;
      padding: 0 20px;
      border-radius: 5px;
      font-size: 18px;
      line-height: 38px;
      font-weight: 500;
      letter-spacing: 0.04em;
    }
  }

  /* mobile (official, 390): centred copy and button, 23/21/700 copy */
  @media screen and (max-width: 749px) {
    .montibello-pro-cta {
      padding-block: 40px !important;
    }

    .montibello-pro-cta__col {
      align-items: center;
      text-align: center;
      gap: 20px;
    }

    .montibello-pro-cta__text {
      font-size: 23px;
      line-height: 21px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .montibello-pro-cta__button {
      height: 40px;
      padding: 0 20px;
      border-radius: 5px;
      font-size: 18px;
      line-height: 38px;
      font-weight: 500;
      letter-spacing: 0.04em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CTA profesional",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Columna izquierda"
    },
    {
      "type": "text",
      "id": "left_text",
      "label": "Texto",
      "default": "¿Tienes un salón pero no eres cliente todavía?"
    },
    {
      "type": "text",
      "id": "left_button_label",
      "label": "Texto del botón",
      "default": "Contacta con un comercial"
    },
    {
      "type": "url",
      "id": "left_button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Columna derecha"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Texto",
      "default": "Localiza tu salón o peluquería Montibello más cercana"
    },
    {
      "type": "text",
      "id": "right_button_label",
      "label": "Texto del botón",
      "default": "Encuentra"
    },
    {
      "type": "url",
      "id": "right_button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Apariencia"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "CTA profesional"
    }
  ]
}
{% endschema %}

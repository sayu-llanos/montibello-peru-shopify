{%- comment -%}
  Reproduces the official homepage's centered editorial statement between the
  hero and the range carousel (hair.montibello.com: centered H1, 40/40px
  desktop, 35/35px mobile, 750px max width, 50px vertical padding, white bg).
{%- endcomment -%}

<div
  class="section section--{{ section.settings.section_width }} montibello-editorial spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}background-color:{{ section.settings.background_color | default: '#FFFFFF' }};"
>
  <h2 class="montibello-editorial__statement">{{ section.settings.statement }}</h2>
</div>

{% stylesheet %}
  .montibello-editorial {
    display: flex;
    justify-content: center;
  }

  .montibello-editorial__statement {
    max-width: 345px;
    margin: 0 auto;
    text-align: center;
    font-size: 35px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  @media screen and (min-width: 750px) {
    .montibello-editorial__statement {
      max-width: 750px;
      font-size: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Declaración editorial",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "textarea",
      "id": "statement",
      "label": "Texto",
      "default": "Transforma tu salón con nosotros. Vive un antes y un después en tu historia."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "full-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Declaración editorial"
    }
  ]
}
{% endschema %}

  /* SMOOTH EXPANSION (Part 3): max-height/opacity are animated inline by
     the JS below (scoped to `[data-montibello-accordion-content]`) — this
     transition declaration is what actually makes those inline style
     changes animate instead of jumping. `prefers-reduced-motion` users
     never get the inline styles set at all (see the JS guard), so they
     keep the native instant toggle. */
  @media (prefers-reduced-motion: no-preference) {
    .montibello-pdp-accordion-item__content {
      transition: max-height 0.28s ease, opacity 0.28s ease;
    }
  }

  /* SMOOTH PREMIUM ENTRANCE (FINAL 20/20 pass, Part 13; extended to UNDER
     in the UNDER 4-PDP parity pass, Part 8 — "reuse the restrained Luxlight
     motion system if technically reusable without cross-family
     regressions": this is purely additive CSS scoped to a second class
     selector, HOP is untouched), CSS-only page-load animation — no JS
     dependency, so there is no risk of content staying invisible if a
     script fails to run. Each `__enter--N` tier gets a progressively later
     `animation-delay` (staggered 70ms apart), a short opacity+translateY
     keyframe, and `both` fill mode so the element sits at its PRE-animation
     state (opacity 0) only for the instant before the animation starts,
     never after it ends. Entirely inside `@media (prefers-reduced-motion:
     no-preference)`, so a reduced-motion user never receives the keyframe
     at all — elements keep their normal default opacity: 1 / no transform,
     i.e. instantly available, satisfying Part 15 without a separate
     override rule. */
  @media (prefers-reduced-motion: no-preference) {
    .montibello-pdp-main--luxlight .montibello-pdp-main__enter,
    .montibello-pdp-main--under .montibello-pdp-main__enter {
      animation: montibello-luxlight-enter 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .montibello-pdp-main--luxlight .montibello-pdp-main__enter--1,
    .montibello-pdp-main--under .montibello-pdp-main__enter--1 {
      animation-delay: 0ms;
    }

    .montibello-pdp-main--luxlight .montibello-pdp-main__enter--2,
    .montibello-pdp-main--under .montibello-pdp-main__enter--2 {
      animation-delay: 80ms;
    }

    .montibello-pdp-main--luxlight .montibello-pdp-main__enter--3,
    .montibello-pdp-main--under .montibello-pdp-main__enter--3 {
      animation-delay: 150ms;
    }

    .montibello-pdp-main--luxlight .montibello-pdp-main__enter--4,
    .montibello-pdp-main--under .montibello-pdp-main__enter--4 {
      animation-delay: 220ms;
    }

    .montibello-pdp-main--luxlight .montibello-pdp-main__enter--5,
    .montibello-pdp-main--under .montibello-pdp-main__enter--5 {
      animation-delay: 290ms;
    }
  }

  @keyframes montibello-luxlight-enter {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  /* GALLERY CROSSFADE (Part 4): scoped to this PDP's own media container
     only — never touches the shared slideshow component's site-wide CSS.
     The native gallery is a scroll-snap track (see snippets/slideshow-
     styles.liquid), so this layers a subtle fade-in on the slide as it
     becomes the active one on top of the existing slide motion, rather
     than replacing the native mechanism (which is shared with every other
     page on the site and out of scope to rewrite here). */
  @media (prefers-reduced-motion: no-preference) {
    .montibello-pdp-main__media slideshow-slide {
      transition: opacity 0.22s ease;
    }

    .montibello-pdp-main__media slideshow-slide[aria-hidden='true'] {
      opacity: 0.55;
    }
  }
{% endstylesheet %}

{% javascript %}
  // SMOOTH ACCORDION EXPANSION (Part 3 of the Luxlight true-parity pass).
  // Shopify dedupes a section's own javascript-tag output automatically,
  // so this runs once regardless of how many montibello-pdp-accordion-item
  // rows are on the page. Native <details>/<summary> semantics are kept
  // throughout (the `open` attribute is still what's actually toggled) —
  // this only adds a height/opacity transition around that toggle.
  (function () {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.addEventListener('click', function (event) {
      var summary = event.target.closest('.montibello-pdp-accordion-item__label');
      if (!summary) return;
      var details = summary.closest('[data-montibello-accordion]');
      if (!details) return;
      var content = details.querySelector('[data-montibello-accordion-content]');
      if (!content || reduceMotion) return; // native instant toggle otherwise

      event.preventDefault();

      if (details.hasAttribute('open')) {
        var startHeight = content.scrollHeight;
        content.style.maxHeight = startHeight + 'px';
        content.style.opacity = '1';
        void content.offsetHeight; // force reflow before animating to 0
        requestAnimationFrame(function () {
          content.style.maxHeight = '0px';
          content.style.opacity = '0';
        });
        content.addEventListener(
          'transitionend',
          function onEnd() {
            content.removeEventListener('transitionend', onEnd);
            details.removeAttribute('open');
            content.style.maxHeight = '';
            content.style.opacity = '';
          },
          { once: true }
        );
      } else {
        details.setAttribute('open', '');
        var endHeight = content.scrollHeight;
        content.style.maxHeight = '0px';
        content.style.opacity = '0';
        void content.offsetHeight; // force reflow before animating up
        requestAnimationFrame(function () {
          content.style.maxHeight = endHeight + 'px';
          content.style.opacity = '1';
        });
        content.addEventListener(
          'transitionend',
          function onEnd() {
            content.removeEventListener('transitionend', onEnd);
            content.style.maxHeight = '';
            content.style.opacity = '';
          },
          { once: true }
        );
      }
    });
  })();

  document.addEventListener('click', function (event) {
    var btn = event.target.closest('[data-ur-features-toggle]');
    if (!btn) return;
    var details = btn.closest('.montibello-pdp-main__details');
    if (!details) return;
    var open = details.classList.toggle('is-features-open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  // HOP ULTRA REPAIR official gallery: thumbnail click, prev/next arrows,
  // keyboard-reachable buttons only (no layout logic in JS).
  (function () {
    document.querySelectorAll('[data-montibello-ur-gallery]').forEach(function (root) {
      var slides = root.querySelectorAll('[data-ur-slide]');
      var thumbs = root.querySelectorAll('[data-ur-thumb]');
      var prev = root.querySelector('[data-ur-prev]');
      var next = root.querySelector('[data-ur-next]');
      var current = 0;
      function show(i) {
        current = Math.max(0, Math.min(slides.length - 1, i));
        slides.forEach(function (el, n) {
          el.classList.toggle('is-active', n === current);
          if (el.tagName === 'VIDEO') {
            if (n === current) { var pr = el.play(); if (pr && pr.catch) pr.catch(function () {}); }
            else el.pause();
          }
        });
        thumbs.forEach(function (el, n) { el.classList.toggle('is-active', n === current); });
        if (prev) prev.hidden = current === 0;
        if (next) next.hidden = current === slides.length - 1;
      }
      thumbs.forEach(function (el, n) { el.addEventListener('click', function () { show(n); }); });
      if (prev) prev.addEventListener('click', function () { show(current - 1); });
      if (next) next.addEventListener('click', function () { show(current + 1); });
      show(0);
    });
  })();
{% endjavascript %}


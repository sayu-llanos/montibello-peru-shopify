

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
>
  {% liquid
    assign total_blocks = section.blocks.size

    # Grid layout calculations
    # Montibello pixel-fidelity: the reference desktop footer reads as
    # brand + 4 structured columns (5 visual columns total). Horizon's
    # stock cap of 4 desktop columns treats a 5th block as an "orphan"
    # that wraps to its own full-width row, which looks broken for a
    # short Compliance/legal column — so the cap is raised to 5 here and
    # the orphan-row logic only engages beyond that (6+ blocks).
    assign grid_columns = total_blocks | at_most: 5

    # Calculate last row counts using modulo arithmetic
    # last_row_count = (total_blocks - 1) % N + 1
    assign last_row_count = total_blocks | minus: 1 | modulo: 5 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    # Check if there are orphaned elements (single item in last row)
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 5 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  <div
    class="
      footer-content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
    data-montibello-accordion
  >
    {% content_for 'blocks' %}
  </div>
</div>

<script>
  (function () {
    var content = document.currentScript.previousElementSibling.querySelector('[data-montibello-accordion]');
    if (!content) return;
    Array.from(content.children).forEach(function (column) {
      column.dataset.open = 'false';
      var inner = column.querySelector('.group-block-content');
      if (!inner) return;
      inner.addEventListener('click', function () {
        column.dataset.open = column.dataset.open === 'true' ? 'false' : 'true';
      });
    });
  })();
</script>

{% stylesheet %}
  .footer-content {
    contain: content;
    content-visibility: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--footer-gap);
    align-items: start;
  }

  .footer-content .menu__heading__default {
    font-weight: var(--font-heading--weight);
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      grid-template-columns: repeat(min(var(--grid-columns), 3), 1fr);
      grid-auto-flow: row;
    }

    .footer-content[style*='--grid-columns: 4'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-content {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }

    /* Single item centered */
    .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }
  }

  /* Montibello pixel-fidelity: reference mobile footer uses ruled accordion
     rows (heading + toggle arrow, content collapses/expands) rather than
     always-open columns. Horizon's footer renders each column as a generic
     `group` block with no built-in accordion, so this is added here as a
     progressive-enhancement layer on top of the existing markup — collapsed
     by default only below the same 750px breakpoint Horizon itself uses for
     mobile footer layout, and inert (does nothing) if JS fails to load. */
  @media screen and (max-width: 749px) {
    .footer-content[data-montibello-accordion] {
      gap: 0;
    }

    .footer-content[data-montibello-accordion] > .group-block:first-child {
      margin-bottom: 20px;
    }

    .footer-content[data-montibello-accordion] > .group-block:not(:first-child) {
      border-block-end: 1px solid #cfcfcf;
      padding-block: 16px;
    }

    .footer-content[data-montibello-accordion] > .group-block:not(:first-child) > .group-block-content {
      position: relative;
      cursor: pointer;
      gap: 0;
    }

    .footer-content[data-montibello-accordion] > .group-block:not(:first-child) > .group-block-content::after {
      content: '\2192';
      position: absolute;
      top: 0;
      right: 0;
      font-size: 22px;
      line-height: 1;
      transition: transform 0.2s ease;
    }

    .footer-content[data-montibello-accordion] > .group-block:not(:first-child)[data-open='true'] > .group-block-content::after {
      transform: rotate(90deg);
      transform-origin: 70% 50%;
    }

    .footer-content[data-montibello-accordion] > .group-block:not(:first-child) > .group-block-content > :not(:first-child) {
      display: none;
    }

    .footer-content[data-montibello-accordion] > .group-block:not(:first-child)[data-open='true'] > .group-block-content > :not(:first-child) {
      display: block;
      margin-top: 12px;
    }
  }

  /* Montibello pixel-fidelity: reference footer column headings measure
     23px/600/-2% and links 16px/500/-1% — Horizon's default h6/rte presets
     render noticeably smaller here (~12px/14px), reading lighter than the
     reference. Scoped to the footer group only, !important because the
     preset's font-size is a CSS custom property resolved via an inline
     style attribute on the text-block wrapper. */
  .shopify-section-group-footer-group .text-block.h6 :is(h1, h2, h3, h4, h5, h6) {
    font-size: 20px !important;
    font-weight: 600 !important;
    line-height: 1.2 !important;
    letter-spacing: -0.01em !important;
  }

  .shopify-section-group-footer-group .text-block.rte :is(p, a) {
    font-size: 15px !important;
    font-weight: 500 !important;
    line-height: 1.6 !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_divider"
    },
    {
      "type": "@app"
    },
    {
      "type": "button"
    },
    {
      "type": "follow-on-shop"
    },
    {
      "type": "group"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "menu"
    },
    {
      "type": "payment-icons"
    },
    {
      "type": "text"
    },
    {
      "type": "logo"
    },
    {
      "type": "jumbo-text"
    },
    {
      "type": "social-links"
    },
    {
      "type": "email-signup"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "gap": 20,
        "padding-block-start": 36,
        "padding-block-end": 36
      },
      "blocks": {
        "newsletter-group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "gap": 6,
            "width": "fill"
          },
          "blocks": {
            "newsletter-heading": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.join_our_email_list",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h3"
              }
            },
            "newsletter-text": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.get_exclusive_deals_and_early_access_to_new_products",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte"
              }
            }
          },
          "block_order": ["newsletter-heading", "newsletter-text"]
        },
        "newsletter-form": {
          "type": "email-signup",
          "settings": {
            "width": "fill"
          }
        }
      },
      "block_order": ["newsletter-group", "newsletter-form"]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Reproduces the official homepage's "Hair Magazine" module architecture: a
  left-hand editorial lead (headline + CTA) beside a horizontally scrollable
  card rail with 50px edge arrows, on the same white section background used
  elsewhere on the reference homepage. Peru has no published magazine/blog
  yet, so this presents curated professional editorial themes linking to the
  real range pages instead of fabricating article titles, authors, or
  publish dates.
{%- endcomment -%}

<div
  class="section section--{{ section.settings.section_width }} montibello-magazine spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="montibello-magazine__inner">
    <div class="montibello-magazine__lead">
      {% if section.settings.eyebrow != blank %}
        <div class="montibello-magazine__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="montibello-magazine__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="montibello-magazine__text">{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link | default: '#' }}" class="montibello-magazine__cta">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>

    <div class="montibello-magazine__viewport">
      <button type="button" class="montibello-magazine__arrow montibello-magazine__arrow--prev" aria-label="Anterior" data-montibello-magazine-prev>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
          <path d="M15 4L7 12L15 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <div class="montibello-magazine__rail" data-montibello-magazine-rail>
        {% content_for 'blocks' %}
      </div>

      <button type="button" class="montibello-magazine__arrow montibello-magazine__arrow--next" aria-label="Siguiente" data-montibello-magazine-next>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
          <path d="M9 4L17 12L9 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>

  <script>
    (function () {
      var section = document.currentScript.closest('.montibello-magazine');
      if (!section) return;
      var rail = section.querySelector('[data-montibello-magazine-rail]');
      var prev = section.querySelector('[data-montibello-magazine-prev]');
      var next = section.querySelector('[data-montibello-magazine-next]');
      if (!rail || !prev || !next) return;

      function step() {
        var card = rail.querySelector('.montibello-magazine-card');
        return card ? card.getBoundingClientRect().width + 24 : rail.clientWidth * 0.8;
      }

      prev.addEventListener('click', function () {
        rail.scrollBy({ left: -step(), behavior: 'smooth' });
      });
      next.addEventListener('click', function () {
        rail.scrollBy({ left: step(), behavior: 'smooth' });
      });

      function updateArrows() {
        var maxScroll = rail.scrollWidth - rail.clientWidth;
        prev.disabled = rail.scrollLeft <= 1;
        next.disabled = rail.scrollLeft >= maxScroll - 1;
      }

      rail.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows);
      updateArrows();
    })();
  </script>
</div>

{% stylesheet %}
  .montibello-magazine__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 1300px;
    width: 100%;
    min-width: 0;
    margin-inline: auto;
    padding-inline: 30px;
  }

  @media screen and (min-width: 990px) {
    .montibello-magazine__inner {
      flex-direction: row;
      align-items: center;
      gap: 60px;
    }
  }

  .montibello-magazine__lead {
    max-width: 750px;
    margin: 0 auto;
    text-align: center;
    color: #2E2D2C;
  }

  @media screen and (min-width: 990px) {
    .montibello-magazine__lead {
      flex: 0 0 300px;
      max-width: 300px;
      margin: 0;
      text-align: left;
    }
  }

  .montibello-magazine__eyebrow {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-bottom: 12px;
  }

  .montibello-magazine__heading {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 16px;
  }

  @media screen and (min-width: 750px) {
    .montibello-magazine__heading {
      font-size: 40px;
    }
  }

  @media screen and (min-width: 990px) {
    .montibello-magazine__heading {
      font-size: 32px;
    }
  }

  .montibello-magazine__text {
    font-size: 16px;
    line-height: 1.5;
    opacity: 0.75;
    margin: 0 0 24px;
  }

  .montibello-magazine__cta {
    display: inline-block;
    color: #2E2D2C;
    font-size: 16px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .montibello-magazine__viewport {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  @media screen and (min-width: 990px) {
    .montibello-magazine__viewport {
      flex: 1;
    }
  }

  .montibello-magazine__rail {
    display: flex;
    flex-wrap: nowrap;
    gap: 24px;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .montibello-magazine__rail::-webkit-scrollbar {
    display: none;
  }

  .montibello-magazine__rail > * {
    scroll-snap-align: start;
  }

  .montibello-magazine__arrow {
    display: none;
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 50px;
    height: 50px;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.32);
    color: #FFFFFF;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .montibello-magazine__arrow:hover {
    background: rgba(0, 0, 0, 0.5);
  }

  .montibello-magazine__arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .montibello-magazine__arrow--prev {
    left: -4px;
  }

  .montibello-magazine__arrow--next {
    right: -4px;
  }

  @media screen and (min-width: 990px) {
    .montibello-magazine__arrow {
      display: flex;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Magazine Montibello",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    { "type": "magazine-card" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Para profesionales"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Educación y tendencias para tu salón"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Contenido profesional Montibello sobre color, cuidado capilar y técnicas de salón."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Conocer más"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Magazine Montibello"
    }
  ]
}
{% endschema %}

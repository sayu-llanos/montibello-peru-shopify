{%- comment -%}
  Reproduces the official homepage's "Hair Magazine" module: the plain
  Montibello wordmark, the exact official heading ("The Hair Magazine para
  profesionales") and CTA ("Descubre más"), beside a horizontally scrollable
  card rail using the same real official article images/titles the
  reference currently publishes. `id="hair-magazine"` gives the header's
  MAGAZINE nav item a genuine on-page destination instead of a fabricated
  standalone page.
{%- endcomment -%}

<div
  id="hair-magazine"
  class="section section--{{ section.settings.section_width }} montibello-magazine spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="montibello-magazine__inner">
    <div class="montibello-magazine__lead">
      <div class="montibello-magazine__masthead">
        <img
          src="{{ 'montibello-logo.svg' | asset_url }}"
          alt="Montibello"
          width="133"
          height="23"
          loading="lazy"
          class="montibello-magazine__logo"
        >
      </div>
      {% if section.settings.heading != blank %}
        <h3 class="montibello-magazine__heading">
          <em>{{ section.settings.heading }}</em>{% if section.settings.heading_suffix != blank %} {{ section.settings.heading_suffix }}{% endif %}
        </h3>
      {% endif %}
      {% if section.settings.button_label != blank %}
        {%- assign magazine_cta_link = section.settings.button_link | default: '#' -%}
        {%- if magazine_cta_link contains '/pages/magazine' and pages['magazine'].handle != 'magazine' -%}{%- assign magazine_cta_link = '#hair-magazine' -%}{%- endif -%}
        <a href="{{ magazine_cta_link }}" class="montibello-magazine__cta">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>

    <div class="montibello-magazine__viewport">
      <button type="button" class="montibello-magazine__arrow montibello-magazine__arrow--prev" aria-label="Anterior" data-montibello-magazine-prev>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
          <path d="M15 4L7 12L15 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <div class="montibello-magazine__rail" data-montibello-magazine-rail>
        {% content_for 'blocks' %}
      </div>

      <button type="button" class="montibello-magazine__arrow montibello-magazine__arrow--next" aria-label="Siguiente" data-montibello-magazine-next>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
          <path d="M9 4L17 12L9 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>

  <script>
    (function () {
      var section = document.currentScript.closest('.montibello-magazine');
      if (!section) return;
      var rail = section.querySelector('[data-montibello-magazine-rail]');
      var prev = section.querySelector('[data-montibello-magazine-prev]');
      var next = section.querySelector('[data-montibello-magazine-next]');
      if (!rail || !prev || !next) return;

      function step() {
        var card = rail.querySelector('.montibello-magazine-card');
        return card ? card.getBoundingClientRect().width + 15 : rail.clientWidth * 0.8;
      }

      function maxScroll() {
        return rail.scrollWidth - rail.clientWidth;
      }

      // Arrows page through the unique cards and wrap at either end, so a
      // short rail never leaves the user with a dead control.
      prev.addEventListener('click', function () {
        if (rail.scrollLeft <= 1) rail.scrollTo({ left: maxScroll(), behavior: 'smooth' });
        else rail.scrollBy({ left: -step(), behavior: 'smooth' });
      });
      next.addEventListener('click', function () {
        if (rail.scrollLeft >= maxScroll() - 1) rail.scrollTo({ left: 0, behavior: 'smooth' });
        else rail.scrollBy({ left: step(), behavior: 'smooth' });
      });

      function updateArrows() {
        var overflow = maxScroll() > 1;
        prev.hidden = !overflow;
        next.hidden = !overflow;
      }

      rail.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows);
      updateArrows();
    })();
  </script>
</div>

{% stylesheet %}
  .montibello-magazine__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 1300px;
    width: 100%;
    min-width: 0;
    margin-inline: auto;
    padding-inline: 30px;
  }

  @media screen and (min-width: 990px) {
    .montibello-magazine__inner {
      flex-direction: row;
      align-items: center;
      gap: 40px;
      padding-inline: 0;
    }
  }

  .montibello-magazine__lead {
    max-width: 750px;
    margin: 0 auto;
    text-align: center;
    color: #2E2D2C;
  }

  @media screen and (min-width: 990px) {
    .montibello-magazine__lead {
      flex: 0 0 295px;
      max-width: 295px;
      margin: 0;
      text-align: left;
    }
  }

  /* Reference masthead is the plain Montibello wordmark (133x23) sitting
     above the "The Hair Magazine para profesionales" heading — not a
     custom text lockup. */
  .montibello-magazine__masthead {
    display: flex;
    justify-content: center;
    margin-bottom: 16px;
  }

  @media screen and (min-width: 990px) {
    .montibello-magazine__masthead {
      justify-content: flex-start;
    }
  }

  .montibello-magazine__logo {
    display: block;
    width: 133px;
    height: 23px;
  }

  .montibello-magazine__heading {
    margin: 0 0 16px;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .montibello-magazine__heading em {
    font-style: italic;
  }

  @media screen and (min-width: 750px) {
    .montibello-magazine__heading {
      font-size: 40px;
      line-height: 40px;
    }
  }

  .montibello-magazine__cta {
    display: inline-block;
    padding: 0 20px;
    background: #000000;
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 500;
    line-height: 38px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 5px;
  }

  .montibello-magazine__cta:hover {
    background: #2E2D2C;
  }

  .montibello-magazine__viewport {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  @media screen and (min-width: 990px) {
    .montibello-magazine__viewport {
      flex: 1;
    }
  }

  .montibello-magazine__rail {
    display: flex;
    flex-wrap: nowrap;
    gap: 15px;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .montibello-magazine__rail::-webkit-scrollbar {
    display: none;
  }

  .montibello-magazine__rail > * {
    scroll-snap-align: start;
  }

  .montibello-magazine__arrow {
    display: none;
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 50px;
    height: 50px;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.32);
    color: #FFFFFF;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .montibello-magazine__arrow:hover {
    background: rgba(0, 0, 0, 0.5);
  }

  .montibello-magazine__arrow[hidden] {
    display: none !important;
  }

  .montibello-magazine__arrow--prev {
    left: 20px;
  }

  .montibello-magazine__arrow--next {
    right: 20px;
  }

  @media screen and (min-width: 990px) {
    .montibello-magazine__arrow {
      display: flex;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Magazine Montibello",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    { "type": "magazine-card" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título (cursiva)",
      "default": "The Hair Magazine"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Título (resto, sin cursiva)",
      "default": "para profesionales"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Descubre más"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Magazine Montibello"
    }
  ]
}
{% endschema %}

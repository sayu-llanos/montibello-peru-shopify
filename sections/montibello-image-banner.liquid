{%- comment -%}
  Editorial image banner for Montibello Perú campaign content (hero / split
  editorial layouts). Horizon's stock media sections (hero, slideshow,
  media-with-content) all source images through `image_picker`, which only
  resolves once a file has been uploaded to the Shopify admin's Files
  library — until then they render a generic placeholder icon. This section
  ships pre-approved official Montibello campaign photography as theme
  assets so the homepage renders with real imagery immediately, while still
  letting a merchant override it with an admin-uploaded image at any time.
{%- endcomment -%}

{% liquid
  assign bundled_image = section.settings.bundled_image
  assign custom_image = section.settings.custom_image
  assign has_custom_image = false
  if custom_image != blank
    assign has_custom_image = true
  endif

  assign has_bundled_image = false
  if bundled_image != blank and bundled_image != 'none'
    assign has_bundled_image = true
  endif

  assign bundled_video = section.settings.bundled_video
  assign has_bundled_video = false
  if bundled_video != blank and bundled_video != 'none'
    assign has_bundled_video = true
  endif

  assign bundled_image_mobile = section.settings.bundled_image_mobile
  assign custom_image_mobile = section.settings.custom_image_mobile
  assign has_custom_image_mobile = false
  if custom_image_mobile != blank
    assign has_custom_image_mobile = true
  endif

  assign has_bundled_image_mobile = false
  if bundled_image_mobile != blank and bundled_image_mobile != 'none'
    assign has_bundled_image_mobile = true
  endif

  assign layout_class = 'montibello-banner--' | append: section.settings.layout
  assign position_class = 'montibello-banner--media-' | append: section.settings.media_position
  assign media_style_class = ''
  if section.settings.media_style == 'framed'
    assign media_style_class = 'montibello-banner--framed'
  endif

  # Native pixel dimensions of each bundled Montibello asset, used only to
  # satisfy the img width/height attributes (the visible box size is
  # controlled by CSS on .montibello-banner__media, not by these).
  assign bundled_width = 1600
  assign bundled_height = 1200
  case bundled_image
    when 'montibello-under-hero-desktop.jpg'
      assign bundled_width = 2560
      assign bundled_height = 960
    when 'montibello-under-editorial-elevated-warmth.jpg'
      assign bundled_width = 2560
      assign bundled_height = 1708
    when 'montibello-under-glucamine-tech.jpg'
      assign bundled_width = 1350
      assign bundled_height = 1080
    when 'montibello-hcare-hop-editorial.jpg'
      assign bundled_width = 2560
      assign bundled_height = 1183
    when 'montibello-professional-salon-editorial.jpg'
      assign bundled_width = 1391
      assign bundled_height = 2086
    when 'montibello-under-stats-editorial.jpg'
      assign bundled_width = 1707
      assign bundled_height = 1766
    when 'montibello-hop-wellbeing-editorial.jpg'
      assign bundled_width = 1702
      assign bundled_height = 1940
    when 'montibello-hop-lifealgae-technology.jpg'
      assign bundled_width = 2560
      assign bundled_height = 1707
    when 'montibello-luxlight-technology-editorial.webp'
      assign bundled_width = 900
      assign bundled_height = 640
    when 'montibello-hop-hero-full-range.jpg'
      assign bundled_width = 2560
      assign bundled_height = 1183
    when 'montibello-hop-lifealgae-tube.webp'
      assign bundled_width = 900
      assign bundled_height = 640
    when 'montibello-hop-ultra-repair-hero.jpg'
      assign bundled_width = 1600
      assign bundled_height = 600
    when 'montibello-hop-repair-collagen-vegano.jpg'
      assign bundled_width = 2560
      assign bundled_height = 1707
    when 'montibello-hop-results-jars.webp'
      assign bundled_width = 900
      assign bundled_height = 640
    when 'montibello-hop-colour-last-hero.jpg'
      assign bundled_width = 1600
      assign bundled_height = 600
    when 'montibello-hop-colour-last-ferulic.webp'
      assign bundled_width = 900
      assign bundled_height = 640
    when 'montibello-hop-smooth-hydration-hero.jpg'
      assign bundled_width = 1600
      assign bundled_height = 600
    when 'montibello-hop-smooth-hydration-hyaluronic.webp'
      assign bundled_width = 900
      assign bundled_height = 640
  endcase

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="
    section section--{{ section.settings.section_width }} montibello-banner spacing-style
    {{ layout_class }}
    {% if section.settings.layout == 'split' %}{{ position_class }} {{ media_style_class }}{% endif %}
    {% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="montibello-banner__media">
    {% if has_bundled_video %}
      <video
        class="montibello-banner__video"
        data-montibello-inline-video
        autoplay
        muted
        loop
        playsinline
        {% if section.settings.video_poster != blank %}poster="{{ section.settings.video_poster | asset_url }}"{% endif %}
      >
        <source src="{{ bundled_video }}" type="video/mp4">
      </video>
      <button
        type="button"
        class="montibello-banner__mute-toggle"
        data-montibello-inline-video-mute
        aria-pressed="true"
      >
        <span data-label-muted>Dejar de silenciar</span>
        <span data-label-unmuted hidden>Silenciar</span>
      </button>
    {% elsif has_custom_image %}
      <picture>
        {% if has_custom_image_mobile %}
          <source media="(max-width: 749px)" srcset="{{ custom_image_mobile | image_url: width: 1500 }}">
        {% elsif has_bundled_image_mobile %}
          <source media="(max-width: 749px)" srcset="{{ bundled_image_mobile | asset_url }}">
        {% endif %}
        {{
          custom_image
          | image_url: width: 3000
          | image_tag:
            loading: 'lazy',
            sizes: '100vw',
            widths: '750,1100,1500,2000,3000',
            alt: section.settings.image_alt | default: custom_image.alt,
            class: 'montibello-banner__image'
        }}
      </picture>
    {% elsif has_bundled_image %}
      <picture>
        {% if has_custom_image_mobile %}
          <source media="(max-width: 749px)" srcset="{{ custom_image_mobile | image_url: width: 1500 }}">
        {% elsif has_bundled_image_mobile %}
          <source media="(max-width: 749px)" srcset="{{ bundled_image_mobile | asset_url }}">
        {% endif %}
        <img
          src="{{ bundled_image | asset_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          loading="lazy"
          class="montibello-banner__image"
          width="{{ bundled_width }}"
          height="{{ bundled_height }}"
        >
      </picture>
    {% else %}
      <div class="montibello-banner__image montibello-banner__image--placeholder">
        {{ 'hero-apparel-3' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if section.settings.layout == 'full' and section.settings.toggle_overlay %}
      <div
        class="montibello-banner__overlay"
        style="background: {{ section.settings.overlay_color }};"
      ></div>
    {% endif %}
  </div>

  <div
    class="montibello-banner__content{% if section.settings.layout == 'full' %} montibello-banner__content--on-media{% endif %}"
    data-montibello-reveal
  >
    {% content_for 'blocks' %}
  </div>
</div>

<script src="{{ 'montibello-scroll-reveal.js' | asset_url }}" defer="defer"></script>

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-montibello-inline-video-mute]').forEach((button) => {
      const wrapper = button.closest('.montibello-banner__media');
      const video = wrapper ? wrapper.querySelector('[data-montibello-inline-video]') : null;
      if (!video) return;
      const labelMuted = button.querySelector('[data-label-muted]');
      const labelUnmuted = button.querySelector('[data-label-unmuted]');
      button.addEventListener('click', () => {
        video.muted = !video.muted;
        button.setAttribute('aria-pressed', String(video.muted));
        labelMuted.hidden = !video.muted;
        labelUnmuted.hidden = video.muted;
      });
    });
  });
{% endjavascript %}

{% stylesheet %}
  .montibello-banner__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    background: #000;
  }

  .montibello-banner__mute-toggle {
    position: absolute;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    padding: 0.6rem 1.25rem;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .montibello-banner {
    display: grid;
    gap: 0;
    position: relative;
  }

  .montibello-banner--split {
    grid-template-columns: 1fr;

    /* The reference keeps these editorial split sections boxed (~1400px,
       ~30px side gutters) even though the rest of the page can run wider —
       matched explicitly here rather than relying on the theme's global
       page-width setting, which may not carry the same value. */
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: 20px;

    @media screen and (min-width: 750px) {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      padding-inline: 30px;
    }
  }

  .montibello-banner--split.montibello-banner--media-right {
    @media screen and (min-width: 750px) {
      & .montibello-banner__media {
        order: 2;
      }

      & .montibello-banner__content {
        order: 1;
      }
    }
  }

  /* Horizon's base .section--full-width > * rule forces every direct child
     to grid-column: 1 / -1 (full span), which silently collapses this
     section's own 2-column split into a stacked layout on desktop even
     though .montibello-banner--split defines two 1fr tracks. Two classes
     (0,2,0) beats the base rule's one class + universal (0,1,0). */
  .montibello-banner--split .montibello-banner__media,
  .montibello-banner--split .montibello-banner__content {
    grid-column: auto;
  }

  /* Framed split: near-square rounded image (native 1350x1080 artwork shown
     in full, no crop) with vertically centered, width-controlled copy. */
  .montibello-banner--framed {
    @media screen and (min-width: 750px) {
      align-items: center;
      column-gap: 24px;
      padding-block: 24px;
    }

    & .montibello-banner__media {
      aspect-ratio: 1350 / 1080;
      min-height: 0;
      border-radius: 24px;
    }

    & .montibello-banner__content {
      max-width: 560px;

      @media screen and (min-width: 750px) {
        padding: 2rem 3rem;
      }
    }
  }

  .montibello-banner--full {
    grid-template-columns: 1fr;
  }

  .montibello-banner__media {
    position: relative;
    overflow: hidden;
    background: var(--color-background-secondary, #ece7dc);
    min-height: 50svh;
  }

  .montibello-banner--split .montibello-banner__media {
    min-height: 42svh;

    @media screen and (min-width: 750px) {
      min-height: 480px;
    }
  }

  .montibello-banner--full .montibello-banner__media {
    /* Reference mobile hero is a dedicated 375x469 portrait crop (≈0.8
       aspect ratio) followed by a separate copy panel below it, not an
       overlaid full-bleed image. */
    aspect-ratio: 375 / 469;
    min-height: 0;
  }

  @media screen and (min-width: 750px) {
    .montibello-banner--full .montibello-banner__media {
      /* Reference hero scales with viewport width at a fixed ~2.667:1
         ratio (1265×474 at 1280px, 1425×534 at 1440px — both ≈2.667),
         matching the 2560×960 source campaign photo. A viewport-height
         based clamp (e.g. 60svh) produces a fixed height regardless of
         width, which is what caused the previous 540px-at-every-desktop-
         width bug; aspect-ratio scales correctly with width instead. */
      aspect-ratio: 2560 / 960;
      min-height: 0;
    }
  }

  .montibello-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    position: absolute;
    inset: 0;
  }

  .montibello-banner__image--placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;

    svg {
      width: 40%;
      height: 40%;
      opacity: 0.35;
    }
  }

  .montibello-banner__overlay {
    position: absolute;
    inset: 0;
  }

  .montibello-banner__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 1rem;
    padding: 2.5rem 1.5rem;

    @media screen and (min-width: 750px) {
      padding: 3rem 4rem;
    }
  }

  .montibello-banner--full .montibello-banner__content--on-media {
    /* Reference mobile composition: the copy sits in its own off-white
       panel below the hero image, not overlaid on top of it. Desktop keeps
       the classic overlay-on-image treatment. */
    position: static;
    color: var(--color-foreground, #2E2D2C);
    background: #F6F6F3;
    padding: 1.75rem 1.5rem;

    @media screen and (min-width: 750px) {
      position: absolute;
      inset: 0;
      z-index: 1;
      color: #fff;
      background: transparent;
      padding-block: 3rem;
      /* Reference hero copy sits at x≈30px, not the 5rem/80px this inherited
         from Horizon's generic banner padding scale. */
      padding-inline: 30px;
    }
  }

  /* Reference headings run bold/tight (≈700 weight, line-height 1) —
     scoped to these banners only, not a sitewide typography change. */
  .montibello-banner__content :is(h1, h2, h3) {
    font-weight: 700;
    line-height: 1;
  }

  /* Block settings hardcode white text for the desktop overlay treatment;
     the mobile off-white copy panel needs dark text instead. !important is
     required here because the block renders its color as an inline style. */
  @media screen and (max-width: 749px) {
    .montibello-banner--full .montibello-banner__content--on-media :is(h1, h2, h3, p) {
      color: var(--color-foreground, #2E2D2C) !important;
    }
  }

  /* Fidelity sprint: the reference HOME hero reads as a slideshow slide, not
     a bespoke landing hero — a compact ~40px/40px headline and a wider,
     16px/20px body column, not the theme's default h1 display scale
     (~56px) and "narrow" (~19.5em) copy width. Horizon sets both the
     heading/paragraph font metrics and the --max-width custom property via
     its own type-preset classes (.text-block.h1, .text-block.rte), so
     !important is required to win over those preset rules without
     changing the sitewide h1/rte presets. Scoped to the full-bleed desktop
     hero only. */
  @media screen and (min-width: 750px) {
    .montibello-banner--full .montibello-banner__content--on-media .text-block.h1 {
      --max-width: 417px !important;
    }

    .montibello-banner--full .montibello-banner__content--on-media .text-block.h1 :is(h1, h2, h3) {
      font-size: 40px !important;
      line-height: 40px !important;
      font-weight: 600 !important;
    }

    .montibello-banner--full .montibello-banner__content--on-media .text-block.rte {
      --max-width: 417px !important;
    }

    .montibello-banner--full .montibello-banner__content--on-media .text-block.rte :is(p) {
      font-size: 16px !important;
      line-height: 20px !important;
    }
  }

  .montibello-banner__content .button-unstyled {
    font-size: 1rem;
    font-weight: 600;
  }

  @media screen and (min-width: 750px) {
    .montibello-banner--full .montibello-banner__content--on-media .button-unstyled {
      /* Reference CTA reads as a modest text link, not an oversized
         display-scale button — balanced against the new 40px headline. */
      font-size: 1rem;
      color: #fff;
    }
  }

  [data-montibello-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  [data-montibello-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-montibello-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Banner Montibello",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    { "type": "text" },
    { "type": "button" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "select",
      "id": "bundled_image",
      "label": "Imagen oficial Montibello incluida",
      "info": "Fotografía de campaña oficial de Montibello, descargada localmente. Se usa como respaldo si no seleccionas una imagen personalizada abajo.",
      "options": [
        { "value": "none", "label": "Ninguna" },
        { "value": "montibello-under-hero-desktop.jpg", "label": "Under — Elevated Warmth (campaña)" },
        { "value": "montibello-under-editorial-elevated-warmth.jpg", "label": "Under — Editorial de línea" },
        { "value": "montibello-under-glucamine-tech.jpg", "label": "Under — Glucamine Nature Tech" },
        { "value": "montibello-hcare-hop-editorial.jpg", "label": "HCare — Editorial de cuidado capilar" },
        { "value": "montibello-professional-salon-editorial.jpg", "label": "Profesional — Editorial de salón" },
        { "value": "montibello-under-stats-editorial.jpg", "label": "Under — Editorial (alta definición)" },
        { "value": "montibello-hop-wellbeing-editorial.jpg", "label": "HOP — Editorial de bienestar" },
        { "value": "montibello-hop-lifealgae-technology.jpg", "label": "HOP — LifeAlgae BioScience (tecnología, obsoleta)" },
        { "value": "montibello-luxlight-technology-editorial.webp", "label": "Luxlight — Bond3 Force System + Metal Shield" },
        { "value": "montibello-hop-hero-full-range.jpg", "label": "HOP — Hero gama completa (oficial)" },
        { "value": "montibello-hop-lifealgae-tube.webp", "label": "HOP — LifeAlgae BioScience (tubo, oficial)" },
        { "value": "montibello-hop-results-jars.webp", "label": "HOP — Resultados (bodegón skincare, oficial)" },
        { "value": "montibello-hop-ultra-repair-hero.jpg", "label": "HOP Ultra Repair — Hero (sin serum)" },
        { "value": "montibello-hop-repair-collagen-vegano.jpg", "label": "HOP Ultra Repair — Colágeno Vegano" },
        { "value": "montibello-hop-colour-last-hero.jpg", "label": "HOP Colour Last — Hero" },
        { "value": "montibello-hop-colour-last-ferulic.webp", "label": "HOP Colour Last — Ácido Ferúlico" },
        { "value": "montibello-hop-smooth-hydration-hero.jpg", "label": "HOP Smooth Hydration — Hero" },
        { "value": "montibello-hop-smooth-hydration-hyaluronic.webp", "label": "HOP Smooth Hydration — Ác. Hialurónico" },
        { "value": "montibello-luxlight-hero-desktop.jpg", "label": "Luxlight — Hero (campaña)" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Vídeo (opcional, sustituye a la imagen)"
    },
    {
      "type": "text",
      "id": "bundled_video",
      "label": "URL del vídeo (CDN de Shopify)",
      "info": "Vídeo autoreproducido, silenciado y en bucle. Si se indica, sustituye a la imagen de este bloque."
    },
    {
      "type": "text",
      "id": "video_poster",
      "label": "Imagen de portada del vídeo (nombre de archivo en assets/)"
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Imagen personalizada (opcional)",
      "info": "Si seleccionas una imagen aquí, reemplaza a la imagen oficial incluida."
    },
    {
      "type": "header",
      "content": "Imagen para móvil (opcional)"
    },
    {
      "type": "select",
      "id": "bundled_image_mobile",
      "label": "Imagen oficial Montibello (recorte móvil)",
      "info": "Se usa solo en pantallas angostas (menos de 750px). Si se deja en Ninguna, se reutiliza la imagen de escritorio.",
      "options": [
        { "value": "none", "label": "Ninguna (usar la imagen de escritorio)" },
        { "value": "montibello-under-hero-mobile.jpg", "label": "Under — Elevated Warmth (recorte móvil)" },
        { "value": "montibello-luxlight-hero-mobile.jpg", "label": "Luxlight — Hero (recorte móvil)" }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "custom_image_mobile",
      "label": "Imagen personalizada para móvil (opcional)",
      "info": "Si seleccionas una imagen aquí, reemplaza al recorte móvil oficial incluido."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo de la imagen"
    },
    {
      "type": "header",
      "content": "Disposición"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Estilo",
      "options": [
        { "value": "split", "label": "Imagen + contenido (editorial)" },
        { "value": "full", "label": "Imagen a pantalla completa (hero)" }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Posición de la imagen",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.layout == 'split' }}"
    },
    {
      "type": "select",
      "id": "media_style",
      "label": "Estilo de la imagen",
      "options": [
        { "value": "default", "label": "Estándar" },
        { "value": "framed", "label": "Enmarcada (casi cuadrada, esquinas redondeadas)" }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.layout == 'split' }}"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Superposición (solo hero)"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "Mostrar superposición sobre la imagen",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color de superposición",
      "alpha": true,
      "default": "#12121266"
    },
    {
      "type": "header",
      "content": "Apariencia"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "placeholder": "Predeterminado"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],

{%- comment -%}
  Reproduces the official homepage's "gamas" card row: a portrait campaign
  image with hover zoom, an uppercase category label, a large tight-leading
  title, and a short paragraph — one card per commercial line (Under, HOP,
  Luxlight), plus an optional smaller/muted "coming soon" teaser card (HOP
  Keratin) with no purchase link. Renders as a static row using the
  reference's exact card proportions rather than the reference's full
  multi-item slider (which only appears once cards overflow the container).
{%- endcomment -%}

<div
  class="section section--{{ section.settings.section_width }} montibello-ranges spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}background-color:{{ section.settings.background_color | default: '#FFFFFF' }};"
>
  <div class="montibello-ranges__viewport">
    <button
      type="button"
      class="montibello-ranges__arrow montibello-ranges__arrow--prev"
      aria-label="Anterior"
      data-montibello-ranges-prev
    >
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
        <path d="M15 4L7 12L15 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <div class="montibello-ranges__list" data-montibello-ranges-list>
      {% content_for 'blocks' %}
    </div>

    <button
      type="button"
      class="montibello-ranges__arrow montibello-ranges__arrow--next"
      aria-label="Siguiente"
      data-montibello-ranges-next
    >
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
        <path d="M9 4L17 12L9 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <script>
    (function () {
      var section = document.currentScript.closest('.montibello-ranges');
      if (!section) return;
      var list = section.querySelector('[data-montibello-ranges-list]');
      var prev = section.querySelector('[data-montibello-ranges-prev]');
      var next = section.querySelector('[data-montibello-ranges-next]');
      if (!list || !prev || !next) return;

      function step() {
        var card = list.querySelector('.montibello-range-card');
        return card ? card.getBoundingClientRect().width + 25 : list.clientWidth * 0.8;
      }

      prev.addEventListener('click', function () {
        list.scrollBy({ left: -step(), behavior: 'smooth' });
      });
      next.addEventListener('click', function () {
        list.scrollBy({ left: step(), behavior: 'smooth' });
      });

      function updateArrows() {
        var maxScroll = list.scrollWidth - list.clientWidth;
        prev.disabled = list.scrollLeft <= 1;
        next.disabled = list.scrollLeft >= maxScroll - 1;
      }

      list.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows);
      updateArrows();
    })();
  </script>
</div>

{% stylesheet %}
  .montibello-ranges__viewport {
    position: relative;
    max-width: 1300px;
    width: 100%;
    min-width: 0;
    margin-inline: auto;
    padding-inline: 30px;
  }

  @media screen and (max-width: 749px) {
    .montibello-ranges__viewport {
      padding-inline: 15px;
    }
  }

  @media screen and (min-width: 1400px) {
    /* At 1440 the reference gutter (~63px) is smaller than the 30px
       viewport padding plus the 70px auto-center margin this box would
       otherwise add on top of it; dropping the inner padding here lets
       the auto-margin alone define the gutter, matching it closely. */
    .montibello-ranges__viewport {
      padding-inline: 0;
    }
  }

  .montibello-ranges__list {
    display: flex;
    flex-wrap: nowrap;
    gap: 25px;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .montibello-ranges__list::-webkit-scrollbar {
    display: none;
  }

  .montibello-ranges__list > * {
    scroll-snap-align: start;
  }

  .montibello-ranges__arrow {
    display: none;
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 50px;
    height: 50px;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.32);
    color: #FFFFFF;
    cursor: pointer;
    transform: translateY(-50%);
    transition: opacity 0.2s ease;
  }

  .montibello-ranges__arrow:hover {
    background: rgba(0, 0, 0, 0.5);
  }

  .montibello-ranges__arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .montibello-ranges__arrow--prev {
    left: 46px;
  }

  .montibello-ranges__arrow--next {
    right: 46px;
  }

  @media screen and (min-width: 990px) {
    .montibello-ranges__arrow {
      display: flex;
    }
  }

  .montibello-range-card {
    display: block;
    flex: 0 0 283px;
    width: 283px;
    color: inherit;
    text-decoration: none;
    border-radius: 5px;
  }

  .montibello-range-card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
  }

  @media screen and (min-width: 750px) {
    .montibello-range-card {
      flex-basis: 385px;
      width: 385px;
      /* Shared desktop shell height so the short Keratin teaser copy
         doesn't collapse its card shorter than the other three. */
      min-height: 661px;
    }
  }

  @media screen and (min-width: 1400px) {
    .montibello-range-card {
      flex-basis: 417px;
      width: 417px;
      min-height: 677px;
    }
  }

  .montibello-range-card__media {
    position: relative;
    overflow: hidden;
    border-radius: 5px;
    aspect-ratio: 822 / 938;
  }

  .montibello-range-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .montibello-range-card:hover .montibello-range-card__image {
    transform: scale(1.03);
  }

  .montibello-range-card--coming-soon {
    cursor: default;
  }

  .montibello-range-card--coming-soon .montibello-range-card__image {
    filter: grayscale(1);
    opacity: 0.75;
  }

  .montibello-range-card--coming-soon:hover .montibello-range-card__image {
    transform: none;
  }

  .montibello-range-card--coming-soon .montibello-range-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(46, 45, 44, 0.35);
  }

  .montibello-range-card__badge {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 1;
    background: #FFFFFF;
    color: #2E2D2C;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 8px 16px;
    border-radius: 100px;
  }

  @media (prefers-reduced-motion: reduce) {
    .montibello-range-card__image {
      transition: none;
    }
  }

  .montibello-range-card__meta {
    margin-top: 30px;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.26;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .montibello-range-card__title {
    margin: 20px 0 0;
    font-size: 35px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;

    @media screen and (min-width: 750px) {
      font-size: 40px;
    }
  }

  .montibello-range-card__text {
    margin-top: 10px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.23;
  }

  .montibello-range-card__text p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gamas Montibello",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    { "type": "range-card" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "full-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Gamas Montibello",
      "blocks": [
        {
          "type": "range-card",
          "settings": {
            "bundled_image": "montibello-under-card-portrait.jpg",
            "category": "Color",
            "title": "Under",
            "text": "La coloración con cobertura de alta definición y tecnología híbrida que potencia la realidad y naturalidad de un color sin límites.",
            "link": "shopify://collections/under"
          }
        },
        {
          "type": "range-card",
          "settings": {
            "bundled_image": "montibello-hop-card-portrait.jpg",
            "category": "Cuidado capilar",
            "title": "HOP",
            "text": "Rutinas profesionales de nutrición, control del frizz y mantenimiento formuladas con biociencia de algas.",
            "link": "/pages/hop"
          }
        },
        {
          "type": "range-card",
          "settings": {
            "bundled_image": "montibello-luxlight-card-portrait.jpg",
            "category": "Decoloración",
            "title": "Luxlight",
            "text": "Sistema de decoloración de alto rendimiento con máximo cuidado y control del resultado en cada aclarado.",
            "link": "/pages/luxlight"
          }
        },
        {
          "type": "range-card",
          "settings": {
            "bundled_image": "montibello-hop-keratin-teaser.jpg",
            "category": "Próximamente",
            "title": "HOP Keratin",
            "text": "Nueva gama en desarrollo.",
            "coming_soon": true
          }
        }
      ]
    }
  ]
}
{% endschema %}

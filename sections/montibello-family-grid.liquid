{%- comment -%}
  Reproduces the official HOP page's "Gamas Hop" component: a centered
  heading followed by a static CSS grid of range cards (bodegón image +
  bold title + "Ver productos →" link) — not a carousel. The reference
  renders exactly 3 columns per row on desktop; a plain `repeat(3, 1fr)`
  grid (rather than `auto-fit`/`auto-fill`) keeps a final partial row from
  stretching wider when a range shows fewer than a multiple of 3 cards,
  which is the Peru case (3 subfamilies exactly, so the grid never
  actually wraps, but the fixed track count keeps that guarantee for any
  future count too).
{%- endcomment -%}

<div
  class="section section--{{ section.settings.section_width }} montibello-family-grid spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}background-color:{{ section.settings.background_color | default: '#FFFFFF' }};"
>
  {% if section.settings.heading != blank %}
    <h2 class="montibello-family-grid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="montibello-family-grid__grid">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .montibello-family-grid__heading {
    margin: 0 0 40px;
    text-align: center;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  @media screen and (min-width: 750px) {
    .montibello-family-grid__heading {
      font-size: 40px;
      margin-bottom: 50px;
    }
  }

  .montibello-family-grid__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px 24px;
    width: 100%;
    max-width: 1300px;
    margin-inline: auto;
    padding-inline: 20px;
    box-sizing: border-box;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(3, 1fr);
      padding-inline: 30px;
    }
  }

  .montibello-family-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .montibello-family-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: 16px;
    background: var(--color-background-secondary, #ece7dc);
  }

  .montibello-family-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.3s ease;
  }

  .montibello-family-card__image,
  .montibello-family-card__media picture,
  .montibello-family-card__media video {
    border-radius: inherit;
  }

  .montibello-family-card:hover .montibello-family-card__image {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .montibello-family-card__image {
      transition: none;
    }
  }

  .montibello-family-card__title {
    margin: 20px 0 0;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .montibello-family-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 8px;
    font-size: 15px;
    font-weight: 500;
  }

  .montibello-family-card__link svg {
    transition: transform 0.2s ease;
  }

  .montibello-family-card:hover .montibello-family-card__link svg {
    transform: translateX(3px);
  }

  /* FULL-SITE PARITY (official /gama/hop/, 1440): heading is left-aligned
     on the 1300px container's edge (40/40), cards are 407x262 (808:520)
     with square corners, a 40px gap and a 40/40 bold title 20px below. */
  @media screen and (min-width: 750px) {
    .montibello-family-grid__heading {
      width: 100%;
      max-width: 1300px;
      margin: 0 auto 20px;
      text-align: center;
      line-height: 40px;
      letter-spacing: -0.03em;
    }

    .montibello-family-grid__grid {
      gap: 40px;
      padding-inline: 0;
    }

    .montibello-family-card__media {
      aspect-ratio: 808 / 520;
      border-radius: 0;
    }

    .montibello-family-card__title {
      font-size: 40px;
      line-height: 40px;
      letter-spacing: -0.03em;
      color: #000;
    }

    .montibello-family-grid__heading {
      color: #000;
    }

    .montibello-family-card__link {
      margin-top: 20px;
      font-size: 16px;
      font-weight: 500;
      color: #000;
    }
  }

  /* mobile (official /gama/hop/ at 390): 15px gutters, left-aligned 35/35
     heading, full-width square cards with a 35px name */
  @media screen and (max-width: 749px) {
    .montibello-family-grid__heading {
      margin: 0 0 20px;
      padding-inline: 15px;
      text-align: center;
      font-size: 35px;
      line-height: 35px;
      letter-spacing: -0.03em;
      color: #000;
    }

    .montibello-family-grid__grid {
      padding-inline: 15px;
      gap: 30px;
    }

    .montibello-family-card__media {
      aspect-ratio: 808 / 520;
      border-radius: 0;
    }

    .montibello-family-card__title {
      font-size: 35px;
      line-height: 35px;
      letter-spacing: -0.03em;
      color: #000;
    }

    .montibello-family-card__link {
      margin-top: 15px;
      font-size: 16px;
      font-weight: 500;
      color: #000;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cuadrícula de gamas",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    { "type": "montibello-family-card" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Gamas Hop"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "full-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Cuadrícula de gamas"
    }
  ]
}
{% endschema %}

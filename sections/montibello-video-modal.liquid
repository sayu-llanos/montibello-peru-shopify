{%- comment -%}
  Single shared video lightbox for a range page. Matches the official
  Montibello Hair UX (poster/CTA instead of a huge autoplaying inline video;
  audio + native controls only start after a user click, per browser
  autoplay-with-sound policy). Any number of triggers elsewhere on the page
  (an <a href="#montibello-video-modal">, or an element carrying
  [data-montibello-video-modal-trigger]) open this one <dialog> — there is
  only one <video> element/source on the page. Uses Shopify's own CDN
  sources, no re-upload.
{%- endcomment -%}

<dialog id="montibello-video-modal" class="montibello-video-modal" aria-label="{{ section.settings.aria_label | default: 'Vídeo Montibello' }}">
  <button type="button" class="montibello-video-modal__close" data-montibello-video-modal-close aria-label="Cerrar vídeo">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
    </svg>
  </button>
  {% if section.settings.video_url != blank %}
    <video
      class="montibello-video-modal__video"
      data-montibello-video-modal-video
      controls
      playsinline
      preload="none"
      {% if section.settings.poster_url != blank %}poster="{{ section.settings.poster_url }}"{% endif %}
    >
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
  {% endif %}
</dialog>

{% stylesheet %}
  html.montibello-video-modal-open {
    overflow: hidden;
  }

  .montibello-video-modal {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: clamp(16px, 4vw, 64px);
    border: none;
    background: rgba(0, 0, 0, 0.92);
    display: none;
    align-items: center;
    justify-content: center;
  }

  .montibello-video-modal[open] {
    display: flex;
  }

  .montibello-video-modal::backdrop {
    background: transparent;
  }

  .montibello-video-modal__video {
    display: block;
    max-width: 100%;
    max-height: calc(100vh - 32px);
    width: auto;
    height: auto;
    background: #000;
    border-radius: 4px;
  }

  .montibello-video-modal__close {
    position: fixed;
    top: clamp(12px, 2vw, 24px);
    right: clamp(12px, 2vw, 24px);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    cursor: pointer;
  }

  .montibello-video-modal__close:hover {
    background: rgba(255, 255, 255, 0.24);
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('montibello-video-modal');
    if (!dialog) return;

    const video = dialog.querySelector('[data-montibello-video-modal-video]');
    const closeButton = dialog.querySelector('[data-montibello-video-modal-close]');

    function openModal() {
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
      document.documentElement.classList.add('montibello-video-modal-open');
      if (video) {
        video.muted = false;
        video.currentTime = 0;
        video.play().catch(() => {});
      }
    }

    function closeModal() {
      if (dialog.open) dialog.close();
    }

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest(
        'a[href="#montibello-video-modal"], [data-montibello-video-modal-trigger]'
      );
      if (!trigger) return;
      event.preventDefault();
      openModal();
    });

    closeButton?.addEventListener('click', closeModal);

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeModal();
    });

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('montibello-video-modal-open');
      if (video) {
        video.pause();
        video.currentTime = 0;
      }
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Modal de vídeo Montibello",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "URL del vídeo (CDN de Shopify Files)"
    },
    {
      "type": "text",
      "id": "poster_url",
      "label": "URL de la imagen de portada"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Etiqueta accesible del modal"
    }
  ],
  "presets": [
    {
      "name": "Modal de vídeo Montibello"
    }
  ]
}
{% endschema %}

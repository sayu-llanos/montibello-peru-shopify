{%- comment -%}
  Montibello PDP — EDITORIAL: key ingredients.

  Matches the reference PDPs' "Ingredientes principales" module (e.g. HOP
  Ultra Repair Shampoo's "Colageno Vegano" / "LifeAlgae Bioscience" pair) —
  a small grid of reusable `montibello_ingredient` metaobjects referenced by
  `product.metafields.montibello.key_ingredients`, accessed with direct dot
  notation (`ingredient.title.value`), not `ingredient.fields.title.value`.
  Hidden entirely when the list is empty; renders a plain text card when a
  referenced ingredient has no image rather than a broken/placeholder image
  box.

  `ingredient.description` is Rich text (`rich_text_field`), rendered with
  `| metafield_tag` on the field drop itself below — `.value` is used only
  for the blank/presence check, never for HTML output.
{%- endcomment -%}

{% liquid
  assign ingredients = product.metafields.montibello.key_ingredients.value
  assign has_ingredients = false
  for ingredient in ingredients
    assign has_ingredients = true
    break
  endfor

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% if has_ingredients %}
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} montibello-pdp-ingredients spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% if section.settings.heading != blank %}
      <h2 class="montibello-pdp-ingredients__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="montibello-pdp-ingredients__grid">
      {% for ingredient in ingredients %}
        <div class="montibello-pdp-ingredients__card">
          {% if ingredient.image.value != blank %}
            {{
              ingredient.image.value
              | image_url: width: 400
              | image_tag: loading: 'lazy', class: 'montibello-pdp-ingredients__image', widths: '200,300,400'
            }}
          {% endif %}
          {% if ingredient.title.value != blank %}
            <h3 class="montibello-pdp-ingredients__title">{{ ingredient.title.value }}</h3>
          {% endif %}
          {% if ingredient.description.value != blank %}
            <div class="montibello-pdp-ingredients__description">{{ ingredient.description | metafield_tag }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .montibello-pdp-ingredients__heading {
    max-width: 1400px;
    margin: 0 auto 24px;
    padding-inline: 20px;
    font-size: 26px;
    font-weight: 700;

    @media screen and (min-width: 750px) {
      padding-inline: 30px;
    }
  }

  .montibello-pdp-ingredients__grid {
    display: grid;
    gap: 24px;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: 20px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));

    @media screen and (min-width: 750px) {
      padding-inline: 30px;
    }
  }

  .montibello-pdp-ingredients__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .montibello-pdp-ingredients__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 5px;
  }

  .montibello-pdp-ingredients__title {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
  }

  .montibello-pdp-ingredients__description {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.8;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Ingredientes",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Ingredientes principales"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}

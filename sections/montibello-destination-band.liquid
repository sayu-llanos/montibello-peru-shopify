{%- comment -%}
  Reproduces the official homepage's salon-locator band: exact official
  heading ("Encuentra tu salón Montibello más cercano.") and support copy
  ("Siempre a tu lado"), same left-heading/right-support visual split. Peru
  has no reliable salon locator yet, so unlike the reference (whose CTA
  reads "Localizador de centros"), this button is honestly labeled and
  routes to real commercial contact instead of claiming a locator that
  does not exist. The reference also carries no body paragraph under the
  heading here — none is fabricated.
{%- endcomment -%}

{% liquid
  assign bundled_image = section.settings.bundled_image
  assign bundled_width = 1391
  assign bundled_height = 2086
  case bundled_image
    when 'montibello-professional-salon-editorial.jpg'
      assign bundled_width = 1391
      assign bundled_height = 2086
    when 'montibello-under-hero-desktop.jpg'
      assign bundled_width = 2560
      assign bundled_height = 960
    when 'montibello-salon-finder-bg.jpg'
      assign bundled_width = 2560
      assign bundled_height = 859
  endcase
%}

<div
  class="section section--{{ section.settings.section_width }} montibello-destination spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="montibello-destination__media">
    {% if bundled_image != blank %}
      <img
        src="{{ bundled_image | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        loading="lazy"
        class="montibello-destination__image"
        width="{{ bundled_width }}"
        height="{{ bundled_height }}"
      >
    {% endif %}
    <div class="montibello-destination__overlay"></div>
  </div>

  <div class="montibello-destination__content">
    <div class="montibello-destination__main">
      {% if section.settings.heading != blank %}
        <h2 class="montibello-destination__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="montibello-destination__text">{{ section.settings.text }}</p>
      {% endif %}
    </div>
    {% if section.settings.support_text != blank or section.settings.button_label != blank %}
      <div class="montibello-destination__support">
        {% if section.settings.support_text != blank %}
          <p class="montibello-destination__support-text">{{ section.settings.support_text }}</p>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link | default: '#' }}" class="montibello-destination__button">{{ section.settings.button_label }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  /* official: 20px of beige above and below the 330px band */
  .shopify-section:has(> .montibello-destination),
  .shopify-section:has(.montibello-destination) {
    padding-block: 20px;
    background: rgb(246, 246, 243);
  }

  .montibello-destination {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    min-height: 300px;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .montibello-destination {
      /* Fidelity sprint: reference locator band reads ~330px tall on
         desktop, not the previous 440px full-campaign-band height. */
      min-height: 330px;
    }
  }

  .montibello-destination__media {
    position: absolute;
    inset: 0;
  }

  .montibello-destination__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .montibello-destination__overlay {
    /* Reference uses a flat rgba(26,26,26,0.4) tint over the salon-finder
       background image, not a gradient. */
    position: absolute;
    inset: 0;
    background: rgba(26, 26, 26, 0.4);
  }

  .montibello-destination__content {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 30px;
    text-align: left;
    color: #FFFFFF;
  }

  @media screen and (min-width: 750px) {
    .montibello-destination__content {
      /* Reference balances a left-side headline against a distinct
         right-side supporting message + CTA, rather than one centered
         block — split into two flex items at desktop. */
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 40px;
      padding: 36px 80px 50px;
    }

    /* official band (1440): 330px tall, 12px radius, headline vertically
       centred on the left, 252px support column (23/700 + black 252x40
       button) on the right, both inset 80px */
    .montibello-destination {
      align-items: stretch;
      border-radius: 12px;
    }

    .montibello-destination .montibello-destination__support {
      width: 252px;
      text-align: center;
    }

    .montibello-destination .montibello-destination__support-text {
      margin: 0 0 12px;
      font-size: 23px;
      line-height: 21px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .montibello-destination .montibello-destination__button {
      display: block;
      padding: 0;
      background: #000;
      font-size: 16px;
      font-weight: 500;
      line-height: 40px;
      text-align: center;
      border-radius: 5px;
    }
  }

  @media screen and (max-width: 749px) {
    /* official mobile: ~380px band, 12px radius, title/support/button stacked bottom-left */
    .montibello-destination {
      min-height: 376px;
      border-radius: 12px;
    }

    .montibello-destination__content {
      justify-content: flex-end;
      gap: 0;
      padding: 30px;
    }

    .montibello-destination__heading {
      max-width: 290px;
      margin-bottom: 20px;
      font-size: 35px;
      line-height: 35px;
    }

    .montibello-destination .montibello-destination__support-text {
      margin: 0 0 10px;
      font-size: 20px;
      line-height: 21px;
      font-weight: 700;
    }

    .montibello-destination .montibello-destination__button {
      display: block;
      width: 252px;
      padding: 0;
      background: #000;
      font-size: 16px;
      font-weight: 500;
      line-height: 40px;
      text-align: center;
      border-radius: 5px;
    }
  }

  .montibello-destination__main {
    max-width: 470px;
  }

  .montibello-destination__support {
    text-align: left;
  }

  @media screen and (min-width: 750px) {
    .montibello-destination__support {
      text-align: right;
      flex-shrink: 0;
    }
  }

  .montibello-destination__support-text {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 12px;
  }

  .montibello-destination__heading {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 470px;
  }

  @media screen and (min-width: 750px) {
    .montibello-destination__heading {
      font-size: 40px;
      line-height: 40px;
    }
  }

  .montibello-destination__text {
    font-size: 15px;
    line-height: 1.4;
    margin: 0;
    opacity: 0.9;
  }

  .montibello-destination__button {
    display: inline-block;
    padding: 16px 32px;
    background: #2E2D2C;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
  }

  .montibello-destination__button:hover {
    background: #000000;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Destino Montibello",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "bundled_image",
      "label": "Imagen",
      "options": [
        { "value": "montibello-salon-finder-bg.jpg", "label": "Oficial — Fondo salon finder (referencia)" },
        { "value": "montibello-professional-salon-editorial.jpg", "label": "Profesional — Editorial de salón" },
        { "value": "montibello-under-hero-desktop.jpg", "label": "Under — Elevated Warmth (campaña)" }
      ],
      "default": "montibello-salon-finder-bg.jpg"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo de la imagen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Encuentra tu salón Montibello más cercano."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto (opcional — la referencia no usa cuerpo de texto aquí)"
    },
    {
      "type": "text",
      "id": "support_text",
      "label": "Mensaje de apoyo (derecha)",
      "default": "Siempre a tu lado"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Contáctanos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Destino Montibello"
    }
  ]
}
{% endschema %}

{%- comment -%}
  "Descubre la gama completa" product grid — reused across UNDER, HOP
  subfamily pages, and LUXLIGHT (Phase 4G manager-review sprint).

  Two independent rendering paths:
  1. `collection.products` (Horizon's native `_product-card` block) — used
     automatically once real products are added as members of the page's
     bound collection AND are ACTIVE. Currently unused (0 members on any
     Montibello collection today), kept for when the catalog goes live.
  2. `product-grid-card` blocks — an explicit, curated list of real Shopify
     products (via a `type: "product"` block setting), one block per
     canonical PDP. This is the path actually rendering right now: it reads
     real product data (image, title, montibello.functional_subtitle,
     variant sizes) via the block's product reference, which resolves
     regardless of product status — unlike `collection.products` or a
     direct `/products/<handle>` visit, a referenced product's data (title,
     image, metafields) is readable in Liquid even while DRAFT. The card's
     link still points to the real PDP URL; visiting it will 404 while the
     product stays DRAFT — a known, reported limitation, not a bug to route
     around by changing product status.

  Falls back to a plain "no products configured yet" note only if neither
  path has anything to show, so this section never renders an empty grid
  shell.
{%- endcomment -%}

{% liquid
  assign has_real_products = false
  if collection != blank and collection.products.size > 0
    assign has_real_products = true
  endif
%}

<div
  class="section section--{{ section.settings.section_width }} montibello-product-range spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="montibello-product-range__header">
    {% content_for 'block', type: 'text', id: 'heading' %}
  </div>

  {% if has_real_products %}
    <div class="montibello-product-range__grid">
      {% for product in collection.products limit: 8 %}
        <div class="montibello-product-range__real-card">
          {% content_for 'block',
            type: '_product-card',
            id: 'static-product-card',
            closest.product: product,
            product_view_context: 'collection'
          %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    {% liquid
      assign grid_card_count = 0
      for block in section.blocks
        if block.type == 'product-grid-card'
          assign grid_card_count = grid_card_count | plus: 1
        endif
      endfor
    %}

    {% if grid_card_count > 0 %}
      <div class="montibello-product-range__grid">
        {% for block in section.blocks %}
          {% if block.type == 'product-grid-card' %}
            {% liquid
              assign card_product = block.settings.product
              assign card_subtitle = card_product.metafields.montibello.functional_subtitle.value
              assign card_sizes = ''
              if card_product != blank
                for variant in card_product.variants
                  if variant.title != 'Default Title' and variant.title != blank
                    if card_sizes == ''
                      assign card_sizes = variant.title
                    else
                      assign card_sizes = card_sizes | append: ' / ' | append: variant.title
                    endif
                  endif
                endfor
              endif
            %}
            <a
              href="{{ card_product.url | default: '#' }}"
              class="montibello-product-range__card"
              {{ block.shopify_attributes }}
            >
              <div class="montibello-product-range__image-wrap">
                {% if card_product.featured_image != blank %}
                  {{
                    card_product.featured_image
                    | image_url: width: 600
                    | image_tag: loading: 'lazy', class: 'montibello-product-range__image', widths: '300,450,600'
                  }}
                {% else %}
                  <div class="montibello-product-range__image-placeholder" aria-hidden="true"></div>
                {% endif %}
              </div>
              <p class="montibello-product-range__name">{{ card_product.title | default: block.settings.fallback_title }}</p>
              {% if card_subtitle != blank %}
                <p class="montibello-product-range__type">{{ card_subtitle }}</p>
              {% endif %}
              {% if card_sizes != blank %}
                <p class="montibello-product-range__sizes">{{ card_sizes }}</p>
              {% endif %}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p class="montibello-product-range__note">{{ section.settings.placeholder_note }}</p>
    {% endif %}
  {% endif %}
</div>

{% stylesheet %}
  .montibello-product-range__header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .montibello-product-range__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem 1.5rem;
    }
  }

  .montibello-product-range__card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .montibello-product-range__image-wrap {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-background-secondary, #ece7dc);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .montibello-product-range__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .montibello-product-range__image-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-background-secondary, #ece7dc);
  }

  .montibello-product-range__name {
    font: var(--font-heading--style) var(--font-heading--weight) var(--font-size--sm) / 1.3 var(--font-heading--family);
    margin: 0;
  }

  .montibello-product-range__type {
    font-size: var(--font-size--xs);
    opacity: 0.7;
    margin: 0;
  }

  .montibello-product-range__sizes {
    font-size: var(--font-size--xs);
    opacity: 0.55;
    margin: 0;
  }

  .montibello-product-range__note {
    text-align: center;
    font-size: var(--font-size--xs);
    opacity: 0.6;
    margin-top: 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gama de productos",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    { "type": "text" },
    { "type": "_product-card" },
    { "type": "product-grid-card" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "page-width"
    },
    {
      "type": "text",
      "id": "placeholder_note",
      "label": "Nota cuando no hay productos configurados",
      "default": "Catálogo completo disponible próximamente en Montibello Perú."
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Gama de productos",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Descubre la gama completa</h2>",
            "type_preset": "h2",
            "alignment": "center",
            "width": "100%"
          }
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": { "product_card_gap": 4 },
          "blocks": {
            "product_card_gallery": {
              "type": "_product-card-gallery",
              "settings": { "image_ratio": "adapt" }
            },
            "product_title": {
              "type": "product-title",
              "settings": { "type_preset": "rte", "padding-block-start": 4 }
            },
            "price": {
              "type": "price",
              "settings": { "type_preset": "h6" }
            }
          },
          "block_order": ["product_card_gallery", "product_title", "price"]
        }
      },
      "block_order": ["heading"]
    }
  ]
}
{% endschema %}

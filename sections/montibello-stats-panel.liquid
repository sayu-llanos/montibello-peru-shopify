      "label": "Archivo PDF incluido",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "montibello-under-carta-color.pdf", "label": "Under — Carta de color" }
      ],
      "default": "montibello-under-carta-color.pdf"
    },
    {
      "type": "text",
      "id": "file_url",
      "label": "URL del PDF (CDN de Shopify Files, opcional)",
      "info": "Si se indica, sustituye al archivo incluido y abre esta URL en una pestaña nueva."
    },
    {

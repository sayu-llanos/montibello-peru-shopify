  ],
  "presets": [
    {
      "name": "Panel de datos Under",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Llega la alta definición del color a la coloración de alta cobertura</h2>",
            "type_preset": "h2"
          }
        }
      },
      "block_order": ["heading"]
    }
  ]
}

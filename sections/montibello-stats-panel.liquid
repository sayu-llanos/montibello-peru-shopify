{%- comment -%}
  Reproduces the official Under page's "Llega la alta definición del color..."
  panel: an image beside a light card holding a vertical stat list, a
  download link to the color-chart PDF, and a footnote — collapsed behind a
  "Ver datos" toggle on mobile only, always open on desktop, exactly as on
  the reference site. No native Horizon section matches this composition
  (image+card split, mobile-only disclosure, separator-lined stat list), so
  it's built as its own section rather than forced into a generic grid.
{%- endcomment -%}

{% liquid
  assign bundled_image = section.settings.bundled_image
  assign custom_image = section.settings.custom_image
  assign has_custom_image = false
  if custom_image != blank
    assign has_custom_image = true
  endif
  assign has_bundled_image = false
  if bundled_image != blank and bundled_image != 'none'
    assign has_bundled_image = true
  endif

  assign bundled_file = section.settings.bundled_file
  assign file_url = section.settings.file_url
  assign has_file = false
  if file_url != blank
    assign has_file = true
  elsif bundled_file != blank and bundled_file != 'none'
    assign has_file = true
    assign file_url = bundled_file | asset_url
  endif

  assign position_class = 'montibello-stats--media-' | append: section.settings.media_position
  assign toggle_id = 'montibello-stats-toggle-' | append: section.id

  assign bundled_width = 1707
  assign bundled_height = 1766
  case bundled_image
    when 'montibello-hop-results-editorial.jpg'
      assign bundled_width = 1445
      assign bundled_height = 1351
    when 'montibello-luxlight-results-editorial.webp'
      assign bundled_width = 900
      assign bundled_height = 640
    when 'montibello-hop-ultra-repair-results.webp'
      assign bundled_width = 900
      assign bundled_height = 640
    when 'montibello-hop-ultra-repair-overnight.jpg'
      assign bundled_width = 900
      assign bundled_height = 640
    when 'montibello-hop-colour-last-results.webp'
      assign bundled_width = 900
      assign bundled_height = 640
    when 'montibello-hop-smooth-hydration-results.webp'
      assign bundled_width = 900
      assign bundled_height = 640
    when 'montibello-luxlight-results-photo.jpg'
      assign bundled_width = 900
      assign bundled_height = 640
  endcase
%}

<div
  class="section section--{{ section.settings.section_width }} montibello-stats {{ position_class }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="montibello-stats__media">
    {% if has_custom_image %}
      {{
        custom_image
        | image_url: width: 2000
        | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 750px) 50vw, 100vw',
          widths: '750,1100,1500,2000',
          alt: section.settings.image_alt | default: custom_image.alt,
          class: 'montibello-stats__image'
      }}
    {% elsif has_bundled_image %}
      <img
        src="{{ bundled_image | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        loading="lazy"
        class="montibello-stats__image"
        width="{{ bundled_width }}"
        height="{{ bundled_height }}"
      >
    {% endif %}
  </div>

  <div class="montibello-stats__card" data-montibello-reveal>
    {% content_for 'block', type: 'text', id: 'heading' %}

    <input type="checkbox" id="{{ toggle_id }}" class="montibello-stats__toggle-input">
    <label class="montibello-stats__toggle-label" for="{{ toggle_id }}">
      {{ section.settings.toggle_label | default: 'Ver datos' }}
      <span class="montibello-stats__toggle-icon" aria-hidden="true"></span>
    </label>

    <div class="montibello-stats__data">
      <ul class="montibello-stats__list">
        {% for i in (1..4) %}
          {% assign num_key = 'stat_' | append: i | append: '_number' %}
          {% assign label_key = 'stat_' | append: i | append: '_label' %}
          {% assign num_value = section.settings[num_key] %}
          {% assign label_value = section.settings[label_key] %}
          {% if num_value != blank or label_value != blank %}
            <li class="montibello-stats__item">
              {% if num_value != blank %}<strong>{{ num_value }}</strong> {% endif %}{{ label_value }}
            </li>
          {% endif %}
        {% endfor %}
      </ul>

      {% if has_file %}
        <a class="montibello-stats__file-link" href="{{ file_url }}" target="_blank" rel="noopener">
          <span class="montibello-stats__file-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" width="18" height="18">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4m4-5l5 5 5-5m-5 5V3"></path>
            </svg>
          </span>
          {{ section.settings.file_label | default: 'Carta de Color' }}
        </a>
      {% endif %}

      {% if section.settings.footnote != blank %}
        <p class="montibello-stats__footnote">{{ section.settings.footnote }}</p>
      {% endif %}
    </div>
  </div>
</div>

<script src="{{ 'montibello-scroll-reveal.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  @media screen and (max-width: 749px) {
    /* collapsed on mobile (official): the Carta de Color download only shows once the data is opened */
    .montibello-stats__toggle-input:not(:checked) ~ .montibello-stats__data .montibello-stats__file-link {
      display: none;
    }
  }

  .montibello-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: 20px;

    @media screen and (min-width: 750px) {
      grid-template-columns: 1fr 1fr;
      padding-inline: 30px;
    }
  }

  .montibello-stats--media-right {
    @media screen and (min-width: 750px) {
      & .montibello-stats__media {
        order: 2;
      }

      & .montibello-stats__card {
        order: 1;
      }
    }
  }

  /* Horizon's base .section--full-width > * rule forces every direct child
     to grid-column: 1 / -1 (full span), which silently collapses this
     section's own 2-column split into a stacked layout on desktop. Two
     classes (0,2,0) beats the base rule's one class + universal (0,1,0). */
  .montibello-stats .montibello-stats__media,
  .montibello-stats .montibello-stats__card {
    grid-column: auto;
  }

  .montibello-stats__media {
    position: relative;
    min-height: 42svh;
    overflow: hidden;
    background: var(--color-background-secondary, #ece7dc);

    @media screen and (min-width: 750px) {
      min-height: 480px;
    }
  }

  .montibello-stats__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .montibello-stats__card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    background: #f6f6f3;
    padding: 2.5rem 1.5rem;

    @media screen and (min-width: 750px) {
      padding: 2.5rem 3.5rem;
    }

    :is(h1, h2, h3) {
      font-weight: 700;
      line-height: 1;
      margin: 0;
    }
  }

  .montibello-stats__toggle-input {
    display: none;
  }

  .montibello-stats__toggle-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-weight: 600;
    width: fit-content;

    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  .montibello-stats__toggle-icon {
    width: 10px;
    height: 10px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.3s ease;
  }

  .montibello-stats__toggle-input:checked ~ .montibello-stats__toggle-label .montibello-stats__toggle-icon {
    transform: rotate(-135deg);
  }

  .montibello-stats__data {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s ease;

    > * {
      overflow: hidden;
    }
  }

  .montibello-stats__toggle-input:checked ~ .montibello-stats__data {
    grid-template-rows: 1fr;
  }

  @media screen and (min-width: 750px) {
    .montibello-stats__data {
      grid-template-rows: 1fr;
    }
  }

  .montibello-stats__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .montibello-stats__item {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border, #e4dfd4);
    font-size: 1rem;

    &:first-child {
      border-top: 1px solid var(--color-border, #e4dfd4);
    }

    strong {
      font-weight: 700;
    }
  }

  .montibello-stats__file-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.65rem 1.25rem;
    border: 1px solid currentColor;
    border-radius: 100px;
    font-size: 0.875rem;
    text-decoration: none;
    color: inherit;
    width: fit-content;
  }

  .montibello-stats__footnote {
    margin-top: 1rem;
    font-size: 0.75rem;
    opacity: 0.65;
  }

  [data-montibello-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  [data-montibello-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-montibello-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* FULL-SITE PARITY: official "Carta de color" button — solid black, 5px
     radius, white tracked uppercase label with the download glyph. */
  .montibello-stats__file-link {
    height: 36px;
    padding: 0 20px;
    border: 0;
    border-radius: 5px;
    background: #000;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Panel de datos Under",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    { "type": "text" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "select",
      "id": "bundled_image",
      "label": "Imagen oficial incluida",
      "options": [
        { "value": "none", "label": "Ninguna" },
        { "value": "montibello-under-stats-editorial.jpg", "label": "Under — Editorial (alta definición)" },
        { "value": "montibello-hop-results-editorial.jpg", "label": "HOP — Resultados (datos)" },
        { "value": "montibello-luxlight-results-editorial.webp", "label": "Luxlight — Resultados (niveles de aclarado)" },
        { "value": "montibello-hop-ultra-repair-results.webp", "label": "HOP Ultra Repair — Resultados (modelo)" },
        { "value": "montibello-hop-ultra-repair-overnight.jpg", "label": "HOP Ultra Repair — Overnight Serum" },
        { "value": "montibello-hop-colour-last-results.webp", "label": "HOP Colour Last — Resultados" },
        { "value": "montibello-hop-smooth-hydration-results.webp", "label": "HOP Smooth Hydration — Resultados" },
        { "value": "montibello-luxlight-results-photo.jpg", "label": "Luxlight — Resultados (campaña)" }
      ],
      "default": "montibello-under-stats-editorial.jpg"
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Imagen personalizada (opcional)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo de la imagen"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Posición de la imagen",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Estadísticas"
    },
    {
      "type": "text",
      "id": "toggle_label",
      "label": "Texto del interruptor móvil",
      "default": "Ver datos"
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Estadística 1 — número",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Estadística 1 — texto",
      "default": "cobertura de canas *"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Estadística 2 — número",
      "default": "95%"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Estadística 2 — texto",
      "default": "relleno de color *"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Estadística 3 — número",
      "default": "95%"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Estadística 3 — texto",
      "default": "intensidad de matiz *"
    },
    {
      "type": "text",
      "id": "stat_4_number",
      "label": "Estadística 4 — número",
      "default": "96%"
    },
    {
      "type": "text",
      "id": "stat_4_label",
      "label": "Estadística 4 — texto",
      "default": "color luminoso *"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Nota al pie",
      "default": "* Evaluación profesional de 512 aplicaciones sobre voluntarias."

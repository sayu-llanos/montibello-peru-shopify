{%- comment -%}
  Peru "Color" landing (/pages/color). Mirrors the international
  hair.montibello.com/color layout: page title, then large editorial range
  cards. Only the ranges Peru carries (Luxlight, Under) are exposed.

  Also rendered bare via `{% section 'montibello-color-landing' %}` from
  layout/theme.liquid when `page.handle == 'color'` (same handle-routing
  mechanism already used for /pages/educacion — the Page's template
  suffix can't be set from theme code, so routing is done by handle
  instead of relying on template assignment). A bare `{% section %}` call
  has no template JSON behind it, so `section.blocks` is always empty in
  that path — block *presets* only prefill the theme editor's "add
  section" UI, they are not applied when a section is instantiated via
  the `{% section %}` tag. `block_defaults` below is this section's own
  built-in Peru range data (identical to templates/page.color.json's two
  blocks) used as a fallback exactly when no blocks are configured, so
  the handle-routed page renders UNDER + LUXLIGHT correctly with zero
  Admin/template dependency, the same way montibello-education carries
  its full content as schema `default`s rather than blocks.
{%- endcomment -%}

{% liquid
  assign cards = section.blocks
  if cards.size == 0
    assign block_defaults = 'luxlight|Máximo poder de aclaración con el máximo cuidado del cabello. Diseñada para cubrir todas las necesidades de los servicios de aclaración.|montibello-color-card-luxlight.webp|Montibello Luxlight — decoloración profesional|shopify://collections/luxlight##Under|La coloración con cobertura de alta definición y tecnología híbrida que potencia la realidad y naturalidad de un color sin límites.|montibello-color-card-under.webp|Montibello Under — coloración con cobertura de alta definición|shopify://collections/under' | split: '##'
  endif
%}

<div class="section section--{{ section.settings.section_width }} montibello-color-landing spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="montibello-color-landing__inner">
    <h1 class="montibello-color-landing__title">{{ section.settings.title }}</h1>
    <div class="montibello-color-landing__grid">
      {%- if cards.size > 0 -%}
        {%- for block in cards -%}
          <a class="montibello-color-landing__card" href="{{ block.settings.link | default: '/collections/all' }}" {{ block.shopify_attributes }}>
            <span class="montibello-color-landing__media">
              <img
                src="{{ block.settings.bundled_image | asset_url }}"
                alt="{{ block.settings.image_alt | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="808"
                height="520"
                class="montibello-color-landing__image"
              >
            </span>
            <span class="montibello-color-landing__name">{{ block.settings.title }}</span>
            <span class="montibello-color-landing__text">{{ block.settings.text }}</span>
            <span class="montibello-color-landing__cta">Ver productos →</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for card in block_defaults -%}
          {%- assign parts = card | split: '|' -%}
          <a class="montibello-color-landing__card" href="{{ parts[4] }}">
            <span class="montibello-color-landing__media">
              <img
                src="{{ parts[2] | asset_url }}"
                alt="{{ parts[3] | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="808"
                height="520"
                class="montibello-color-landing__image"
              >
            </span>
            <span class="montibello-color-landing__name">{{ parts[0] }}</span>
            <span class="montibello-color-landing__text">{{ parts[1] }}</span>
            <span class="montibello-color-landing__cta">Ver productos →</span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .montibello-color-landing__inner {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: 20px;

    @media screen and (min-width: 750px) {
      padding-inline: 30px;
    }
  }

  .montibello-color-landing__title {
    margin: 0 0 32px;
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;

    @media screen and (min-width: 750px) {
      font-size: 56px;
      margin-bottom: 48px;
    }
  }

  .montibello-color-landing__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;

    @media screen and (min-width: 750px) {
      grid-template-columns: 1fr 1fr;
      gap: 25px;
    }
  }

  .montibello-color-landing__card {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .montibello-color-landing__card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
  }

  .montibello-color-landing__media {
    display: block;
    overflow: hidden;
    border-radius: 5px;
    aspect-ratio: 4 / 5;
    background: var(--color-background-secondary, #ece7dc);
  }

  .montibello-color-landing__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .montibello-color-landing__card:hover .montibello-color-landing__image {
    transform: scale(1.03);
  }

  .montibello-color-landing__name {
    margin-top: 24px;
    font-size: 35px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;

    @media screen and (min-width: 750px) {
      font-size: 40px;
    }
  }

  .montibello-color-landing__text {
    margin-top: 12px;
    max-width: 560px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.3;
  }

  .montibello-color-landing__cta {
    margin-top: 16px;
    font-size: 16px;
    font-weight: 600;
  }

  .montibello-color-landing__card:hover .montibello-color-landing__cta {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .montibello-color-landing__image { transition: none; }
  }

  /* FULL-SITE PARITY (official /color/, 1440): beige page tone, 1300px
     container, two 643px landscape cards (808:520, 12px radius) 14px apart,
     lowercase 40/40 range names, 16/19.7 copy and a 16px "Ver productos →". */
  .montibello-color-landing {
    background-color: rgb(246, 246, 243);
    color: #000;
  }

  @media screen and (min-width: 750px) {
    .montibello-color-landing {
      padding-block-start: 40px !important;
    }

    .montibello-color-landing__inner {
      max-width: 1300px;
      padding-inline: 0;
    }

    .montibello-color-landing__title {
      margin-bottom: 40px;
      line-height: 40px;
      font-size: 40px;
    }

    .montibello-color-landing__grid {
      gap: 40px 14px;
    }

    .montibello-color-landing__media {
      aspect-ratio: 808 / 520;
      border-radius: 12px;
    }

    .montibello-color-landing__name {
      margin-top: 20px;
      line-height: 40px;
      text-transform: none;
    }

    .montibello-color-landing__text {
      margin-top: 20px;
      max-width: none;
      line-height: 19.7px;
    }

    .montibello-color-landing__cta {
      margin-top: 20px;
      font-weight: 500;
    }
  }

  .montibello-color-landing__name {
    text-transform: none;
  }

  .montibello-color-landing__cta {
    font-size: 16px !important;
    line-height: 19.7px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Landing Color",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "range",
      "name": "Gama",
      "settings": [
        { "type": "text", "id": "bundled_image", "label": "Imagen incluida (assets/)" },
        { "type": "text", "id": "image_alt", "label": "Texto alternativo" },
        { "type": "text", "id": "title", "label": "Nombre de la gama" },
        { "type": "textarea", "id": "text", "label": "Descripción" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Color" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "full-width"
    },
    { "type": "range", "id": "padding-block-start", "label": "Superior", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Inferior", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Landing Color" }]
}
{% endschema %}

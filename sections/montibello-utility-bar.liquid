{%- comment -%}
  Reproduces the official site's black utility bar above the main header
  (hair.montibello.com .tm-toolbar.tm-toolbar-default): 49px tall, black
  background, right-aligned 12px/500-weight links with vertical dividers.
  Peru only links to pages that actually exist here (Contacto, Nosotros) —
  the official bar's login portal, e-learning platform, and store locator
  are not part of Peru's scope and are deliberately not reproduced.
{%- endcomment -%}

<div class="montibello-utility-bar">
  <div class="montibello-utility-bar__inner">
    <ul class="montibello-utility-bar__list">
      {% for block in section.blocks %}
        <li class="montibello-utility-bar__item" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="montibello-utility-bar__link">{{ block.settings.label }}</a>
          {% else %}
            <span class="montibello-utility-bar__link">{{ block.settings.label }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .montibello-utility-bar {
    background: #000;
  }

  /* the official toolbar is hidden below its 1200px desktop breakpoint */
  @media screen and (max-width: 1199px) {
    .montibello-utility-bar {
      display: none;
    }
  }

  .montibello-utility-bar__inner {
    padding: 10px 30px;
  }

  .montibello-utility-bar__list {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .montibello-utility-bar__item {
    display: flex;
    align-items: center;
  }

  .montibello-utility-bar__item:not(:first-child) {
    border-inline-start: 1px solid rgba(255, 255, 255, 0.3);
  }

  .montibello-utility-bar__link {
    display: block;
    padding-inline: 15px;
    line-height: 29px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #FFFFFF;
    text-decoration: none;
  }

  a.montibello-utility-bar__link:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .montibello-utility-bar {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Barra de utilidades",
  "blocks": [
    {
      "type": "link",
      "name": "Enlace",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto",
          "default": "Contacto"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Barra de utilidades",
      "blocks": [
        { "type": "link", "settings": { "label": "¿Eres profesional?", "link": "/pages/contact" } },
        { "type": "link", "settings": { "label": "Contacto", "link": "/pages/contact" } }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Reproduces the official homepage's "Ínspirate con nosotros @montibellopro"
  module as a horizontal media rail with edge arrows. Uses the SAME official
  community media the live reference currently shows, in the same relative
  order (downloaded from hair.montibello.com /wp-content/uploads/2026/01/):
  01 (video), 02–05, 06 ("Proven results"), 07, 08 — skipping only the 2
  items outside Peru's commercial scope (an Éclat tile, item 09, and an
  m.lab tile, item 10). The @montibellopro handle is reproduced as global
  Montibello brand/editorial content, not claimed as a Peru-specific
  account.

  Infinite loop: the rail keeps native scroll (so trackpad/touch/drag all
  keep working) but renders THREE copies of the same media set back to
  back. It boots scrolled into the middle copy, and a scroll listener
  silently snaps `scrollLeft` back by exactly one set-width whenever the
  user scrolls into the trailing copy (or forward by one set-width when
  scrolled into the leading copy) — since the copies are pixel-identical,
  the snap lands on the same visual frame and is imperceptible. Arrows
  never disable since there is no real end.
{%- endcomment -%}

{% capture media_set %}
  <video class="montibello-community__image" width="840" height="1050" autoplay muted loop playsinline preload="metadata" aria-label="Montibello, desde 1967">
    <source src="{{ 'montibello-community-video.mp4' | asset_url }}" type="video/mp4">
  </video>
  <img src="{{ 'montibello-community-02.jpg' | asset_url }}" alt="Montibello HOP" loading="lazy" class="montibello-community__image" width="840" height="1050">
  <img src="{{ 'montibello-community-03.jpg' | asset_url }}" alt="Montibello HOP Ultra Repair" loading="lazy" class="montibello-community__image" width="840" height="1050">
  <img src="{{ 'montibello-community-04.jpg' | asset_url }}" alt="Resultado de salón Montibello" loading="lazy" class="montibello-community__image" width="840" height="1050">
  <img src="{{ 'montibello-community-05.jpg' | asset_url }}" alt="Montibello Under" loading="lazy" class="montibello-community__image" width="840" height="1050">
  <img src="{{ 'montibello-community-proven-results.png' | asset_url }}" alt="Proven results — productos eficaces, puros y seguros" loading="lazy" class="montibello-community__image" width="840" height="1050">
  <img src="{{ 'montibello-community-07.jpg' | asset_url }}" alt="Resultado de salón Montibello" loading="lazy" class="montibello-community__image" width="840" height="1050">
  <img src="{{ 'montibello-community-08.jpg' | asset_url }}" alt="Montibello HOP" loading="lazy" class="montibello-community__image" width="840" height="1050">
{% endcapture %}

<div
  class="section section--{{ section.settings.section_width }} montibello-community spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}background-color:{{ section.settings.background_color | default: '#F6F6F3' }};"
>
  {% if section.settings.heading != blank %}
    <h2 class="montibello-community__heading">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.subheading != blank %}
    <p class="montibello-community__subheading">{{ section.settings.subheading }}</p>
  {% endif %}

  <div class="montibello-community__viewport">
    <button type="button" class="montibello-community__arrow montibello-community__arrow--prev" aria-label="Anterior" data-montibello-community-prev>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
        <path d="M15 4L7 12L15 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <div class="montibello-community__rail" data-montibello-community-rail>
      <div class="montibello-community__set" data-montibello-community-set>{{ media_set }}</div>
      <div class="montibello-community__set" data-montibello-community-set>{{ media_set }}</div>
      <div class="montibello-community__set" data-montibello-community-set>{{ media_set }}</div>
    </div>

    <button type="button" class="montibello-community__arrow montibello-community__arrow--next" aria-label="Siguiente" data-montibello-community-next>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
        <path d="M9 4L17 12L9 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <script>
    (function () {
      var section = document.currentScript.closest('.montibello-community');
      if (!section) return;
      var rail = section.querySelector('[data-montibello-community-rail]');
      var prev = section.querySelector('[data-montibello-community-prev]');
      var next = section.querySelector('[data-montibello-community-next]');
      var sets = section.querySelectorAll('[data-montibello-community-set]');
      if (!rail || !prev || !next || sets.length < 3) return;

      var settling = false;
      var settleTimer = null;

      function setWidth() {
        // Distance from the start of one set to the start of the next —
        // this is what one full backward/forward wrap must jump by.
        return sets[1].offsetLeft - sets[0].offsetLeft;
      }

      function step() {
        var item = rail.querySelector('.montibello-community__image');
        return item ? item.getBoundingClientRect().width + 20 : rail.clientWidth * 0.8;
      }

      function initPosition() {
        // Boot scrolled to the start of the middle (real) copy.
        rail.scrollLeft = sets[1].offsetLeft;
      }

      function settleLoop() {
        var width = setWidth();
        if (!width) return;
        var min = sets[0].offsetLeft;
        var max = sets[2].offsetLeft;
        if (rail.scrollLeft >= max) {
          rail.style.scrollBehavior = 'auto';
          rail.scrollLeft -= width;
          rail.style.scrollBehavior = '';
        } else if (rail.scrollLeft < min) {
          rail.style.scrollBehavior = 'auto';
          rail.scrollLeft += width;
          rail.style.scrollBehavior = '';
        }
      }

      function onScroll() {
        if (settleTimer) clearTimeout(settleTimer);
        settleTimer = setTimeout(settleLoop, 120);
      }

      prev.addEventListener('click', function () {
        rail.scrollBy({ left: -step(), behavior: 'smooth' });
      });
      next.addEventListener('click', function () {
        rail.scrollBy({ left: step(), behavior: 'smooth' });
      });

      rail.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', initPosition);
      initPosition();
    })();
  </script>
</div>

{% stylesheet %}
  .montibello-community__heading {
    max-width: 750px;
    margin: 0 auto;
    padding-inline: 30px;
    text-align: center;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  @media screen and (min-width: 750px) {
    .montibello-community__heading {
      font-size: 40px;
      line-height: 40px;
    }
  }

  .montibello-community__subheading {
    max-width: 750px;
    margin: 12px auto 30px;
    padding-inline: 30px;
    text-align: center;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    opacity: 0.85;
  }

  @media screen and (min-width: 750px) {
    .montibello-community__subheading {
      font-size: 23px;
      line-height: 28px;
    }
  }

  .montibello-community__viewport {
    position: relative;
    max-width: 1300px;
    width: 100%;
    min-width: 0;
    margin-inline: auto;
    padding-inline: 30px;
  }

  .montibello-community__rail {
    display: flex;
    flex-wrap: nowrap;
    gap: 20px;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .montibello-community__rail::-webkit-scrollbar {
    display: none;
  }

  .montibello-community__set {
    display: flex;
    flex-wrap: nowrap;
    gap: 20px;
  }

  .montibello-community__image {
    display: block;
    flex: 0 0 240px;
    width: 240px;
    height: 320px;
    object-fit: cover;
    border-radius: 5px;
    scroll-snap-align: start;
    transition: transform 0.5s ease;
  }

  @media screen and (min-width: 750px) {
    .montibello-community__image {
      flex-basis: 320px;
      width: 320px;
      height: 440px;
    }
  }

  .montibello-community__image:hover {
    transform: scale(1.03);
  }

  .montibello-community__arrow {
    display: none;
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 50px;
    height: 50px;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.32);
    color: #FFFFFF;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .montibello-community__arrow:hover {
    background: rgba(0, 0, 0, 0.5);
  }

  .montibello-community__arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .montibello-community__arrow--prev {
    left: -4px;
  }

  .montibello-community__arrow--next {
    right: -4px;
  }

  @media screen and (min-width: 990px) {
    .montibello-community__arrow {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .montibello-community__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Comunidad Montibello",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Ínspirate con nosotros @montibellopro"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Únete a nuestra comunidad #montibellopro"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "full-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#F6F6F3"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Comunidad Montibello"
    }
  ]
}
{% endschema %}

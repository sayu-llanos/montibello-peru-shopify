{%- comment -%}
  Reproduces the official homepage's rotating campaign hero (UIkit
  `.uk-slideshow`, `ratio: 16:6`, no autoplay — manual arrow navigation
  only, matching the reference exactly). Each slide is a block: bundled
  campaign image + eyebrow/logo + heading + text + CTA, one per confirmed
  Peru range (Under / HOP / Luxlight). Does not add slides for ranges
  outside Peru's approved commercial scope (m.lab, Éclat, Dénuée, HOP Sun
  Care) even though the current official rotation includes them.
{%- endcomment -%}

<div
  class="section section--{{ section.settings.section_width }} montibello-hero-slider spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-montibello-hero-slider
  data-section-id="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-ms="{{ section.settings.autoplay_speed | default: 5 | times: 1000 }}"
>
  <div class="montibello-hero-slider__track" data-montibello-hero-slider-track>
    {% content_for 'blocks' %}
  </div>

  <button type="button" class="montibello-hero-slider__nav montibello-hero-slider__nav--prev" aria-label="Diapositiva anterior" data-montibello-hero-slider-prev>
    <svg width="17" height="8" viewBox="0 0 17 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M3.3.1c.2-.2.5-.2.7,0,.2.2.2.5,0,.7L1.2,3.7l2.8,2.8c.2.2.2.5,0,.7s-.5.2-.7,0L.1,4c-.2-.2-.2-.5,0-.7L3.3.1ZM.5,3.2h16.2v.5s0,.5,0,.5H.5v-.5s0-.5,0-.5Z" fill="currentColor" />
    </svg>
  </button>
  <button type="button" class="montibello-hero-slider__nav montibello-hero-slider__nav--next" aria-label="Siguiente diapositiva" data-montibello-hero-slider-next>
    <svg width="17" height="8" viewBox="0 0 17 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M13.7.1c-.2-.2-.5-.2-.7,0-.2.2-.2.5,0,.7l2.8,2.9-2.8,2.8c-.2.2-.2.5,0,.7s.5.2.7,0L16.9,4c.2-.2.2-.5,0-.7L13.7.1ZM16.5,3.2H.3v.5s0,.5,0,.5h16.2v-.5s0-.5,0-.5Z" fill="currentColor" />
    </svg>
  </button>

  <div class="montibello-hero-slider__dots" data-montibello-hero-slider-dots></div>

  <script>
  (function () {
    var root = document.currentScript.closest('[data-montibello-hero-slider]');
    if (!root) return;
    var track = root.querySelector('[data-montibello-hero-slider-track]');
    // Shopify wraps each `content_for 'blocks'` item in its own
    // `.shopify-block` div, so the actual slide elements are grandchildren
    // of track, not track.children directly.
    var slides = Array.prototype.slice.call(track.querySelectorAll('.montibello-hero-slide'));
    var prev = root.querySelector('[data-montibello-hero-slider-prev]');
    var next = root.querySelector('[data-montibello-hero-slider-next]');
    var dotsWrap = root.querySelector('[data-montibello-hero-slider-dots]');
    if (slides.length <= 1) {
      if (prev) prev.hidden = true;
      if (next) next.hidden = true;
      return;
    }

    var index = 0;
    var dots = slides.map(function (_, i) {
      var dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'montibello-hero-slider__dot';
      dot.setAttribute('aria-label', 'Ir a la diapositiva ' + (i + 1));
      dot.addEventListener('click', function () {
        goTo(i);
      });
      dotsWrap.appendChild(dot);
      return dot;
    });

    function render() {
      slides.forEach(function (slide, i) {
        slide.classList.toggle('is-active', i === index);
        slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      });
      dots.forEach(function (dot, i) {
        dot.classList.toggle('is-active', i === index);
      });
    }

    // Autoplay: one rescheduling timeout per section instance. Every goTo()
    // (arrows, dots, autoplay itself) restarts the countdown.
    var sectionId = root.getAttribute('data-section-id');
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var autoplayOn = root.getAttribute('data-autoplay') === 'true' && !reduceMotion;
    var delay = parseInt(root.getAttribute('data-autoplay-ms'), 10) || 5000;
    var timer = null;
    var hovered = false;
    var editorPaused = false;

    function stop() {
      if (timer) {
        clearTimeout(timer);
        timer = null;
      }
    }

    function schedule() {
      stop();
      if (!autoplayOn || hovered || editorPaused || document.hidden) return;
      timer = setTimeout(function () {
        if (!root.isConnected) {
          destroy();
          return;
        }
        goTo(index + 1);
      }, delay);
    }

    function goTo(i) {
      index = (i + slides.length) % slides.length;
      render();
      schedule();
    }

    function onVisibility() {
      if (document.hidden) stop();
      else schedule();
    }

    // Theme editor: selecting a slide block shows it and holds autoplay;
    // deselecting resumes. Unload tears down everything this instance added
    // outside its own DOM.
    function onBlockSelect(e) {
      if (!root.contains(e.target)) return;
      var target = e.target;
      var found = slides.findIndex(function (slide) {
        return target === slide || target.contains(slide) || slide.contains(target);
      });
      editorPaused = true;
      if (found > -1) {
        index = found;
        render();
      }
      stop();
    }

    function onBlockDeselect(e) {
      if (!root.contains(e.target)) return;
      editorPaused = false;
      schedule();
    }

    function onSectionUnload(e) {
      if (e.detail && e.detail.sectionId === sectionId) destroy();
    }

    function destroy() {
      stop();
      document.removeEventListener('visibilitychange', onVisibility);
      document.removeEventListener('shopify:block:select', onBlockSelect);
      document.removeEventListener('shopify:block:deselect', onBlockDeselect);
      document.removeEventListener('shopify:section:unload', onSectionUnload);
    }

    prev.addEventListener('click', function () {
      goTo(index - 1);
    });
    next.addEventListener('click', function () {
      goTo(index + 1);
    });

    document.addEventListener('visibilitychange', onVisibility);
    document.addEventListener('shopify:block:select', onBlockSelect);
    document.addEventListener('shopify:block:deselect', onBlockDeselect);
    document.addEventListener('shopify:section:unload', onSectionUnload);

    // touch swipe (mobile hero)
    var touchX = null;
    track.addEventListener('touchstart', function (e) { touchX = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', function (e) {
      if (touchX === null) return;
      var dx = e.changedTouches[0].clientX - touchX;
      touchX = null;
      if (Math.abs(dx) > 40) goTo(index + (dx < 0 ? 1 : -1));
    }, { passive: true });

    root.classList.add('js-hero-ready');
    render();
    schedule();
  })();
  </script>
</div>

{% stylesheet %}
  .montibello-hero-slider {
    position: relative;
    overflow: hidden;
  }

  .montibello-hero-slider__track {
    position: relative;
    aspect-ratio: 375 / 469;
  }

  @media screen and (max-width: 749px) {
    /* image 375x469 + copy panel (≈287px) as on the official mobile hero */
    .montibello-hero-slider__track {
      aspect-ratio: 375 / 756;
      min-height: 0;
    }

    .montibello-hero-slide__content {
      min-height: 0;
    }
  }

  @media screen and (min-width: 750px) {
    .montibello-hero-slider__track {
      /* Reference: uk-slideshow ratio 16:6 (≈2.667:1), matching the
         2560×960 campaign photography — no autoplay confirmed on the live
         reference, so navigation is manual-arrow-only. */
      aspect-ratio: 2560 / 960;
    }
  }

  .montibello-hero-slider__nav {
    /* Matches the reference's arrow treatment used identically across every
       carousel on the homepage (hero, ranges, product, magazine, community):
       a 50x50 circle at rgba(0,0,0,0.32), flush with the slide edge. */
    display: none;
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 50px;
    height: 50px;
    align-items: center;
    justify-content: center;
    transform: translateY(-50%);
    padding: 0;
    background: rgba(0, 0, 0, 0.32);
    border: none;
    border-radius: 50%;
    color: #FFFFFF;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .montibello-hero-slider__nav:hover {
    background: rgba(0, 0, 0, 0.5);
  }

  .montibello-hero-slider__nav--prev {
    left: 20px;
  }

  .montibello-hero-slider__nav--next {
    right: 20px;
  }

  /* official arrows only appear while the slideshow is hovered/focused */
  @media (hover: hover) {
    .montibello-hero-slider__nav {
      opacity: 0;
      transition: opacity 0.25s ease, background 0.2s ease;
    }

    .montibello-hero-slider:hover .montibello-hero-slider__nav,
    .montibello-hero-slider:focus-within .montibello-hero-slider__nav {
      opacity: 1;
    }
  }

  @media screen and (min-width: 990px) {
    .montibello-hero-slider__nav {
      display: flex;
    }
  }

  .montibello-hero-slider__dots {
    display: none !important;
    position: absolute;
    bottom: 20px;
    right: 30px;
    z-index: 2;
    display: flex;
    gap: 8px;
  }

  .montibello-hero-slider__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.8);
    background: transparent;
    cursor: pointer;
  }

  .montibello-hero-slider__dot.is-active {
    background: #FFFFFF;
  }

  @media (prefers-reduced-motion: reduce) {
    .montibello-hero-slider .montibello-hero-slide {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero — Slider Montibello",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    { "type": "hero-slide" }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotación automática",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Tiempo entre banners",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero — Slider Montibello"
    }
  ]
}
{% endschema %}

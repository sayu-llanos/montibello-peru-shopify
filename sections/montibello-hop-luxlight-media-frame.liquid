    [id$='__stats_carta_under'],
    [id$='__glucamine_under'],
    [id$='__elevated_warmth_under']
  ) :is(
    .montibello-stats__media,
    .montibello-banner__media,
    .montibello-feature-rows__media
  ) {
    /* `width: 100%` is required alongside `aspect-ratio`: these media
       boxes sit in an `align-items: stretch` grid row, so height is
       already definite from the row; without a definite width too, the
       browser derives width FROM that stretched height via the
       aspect-ratio instead of from the 1fr grid track, which is what
       produced wildly different, overflowing widths per section here. */
    width: 100%;
    aspect-ratio: 650 / 462;
    /* `!important`: the base component sets `min-height: 480px` at this
       same (0,2,0) specificity for the split-video case, which wins the
       cascade tie by later source order and floors the frame's height
       above the measured 424px ratio-derived value otherwise. */
    min-height: 0 !important;
    height: auto;
    border-radius: 12px;
    overflow: hidden;

    @media screen and (max-width: 749px) {
      aspect-ratio: 4 / 3;
    }
  }

  /* Service 360 comparison slider: round the wrapper the same way; the
     slider's own layers already fill it edge-to-edge via absolute
     positioning, so clipping the wrapper is enough — no change to the
     drag/compare behavior. */
  [id$='__service_luxlight'] .montibello-before-after {
    border-radius: inherit;
    overflow: hidden;
  }


    [id$='__technology_hop'],
    [id$='__results_hop'],
    [id$='__results_ultra_repair'],
    [id$='__technology_ultra_repair'],
    [id$='__overnight_ultra_repair'],
    [id$='__results_colour_last'],
    [id$='__ferulic_colour_last'],
    [id$='__results_smooth_hydration'],
    [id$='__hyaluronic_smooth_hydration'],
    [id$='__stats_carta_under'],
    [id$='__glucamine_under'],
    [id$='__elevated_warmth_under']
    ) .montibello-feature-rows__content {
      gap: 0;
    }

    .montibello-feature-rows__heading {
      margin-bottom: 20px;
    }

    .montibello-stats__item:first-child {
      border-top: 0;
    }

    /* stats copy: 50px inset on both sides of the 650px card (official 550px text column) */
    @media screen and (min-width: 750px) {
      .montibello-stats__card > :is(.montibello-stats__data, .text-block, .montibello-stats__heading) {
        padding-inline: 30px 50px;
      }
    }

    .montibello-stats__footnote {
      opacity: 1;
      font-size: 12px;
    }
  }

  /* FULL-SITE PARITY — mobile (official /gama/hop/ at 390): 15px gutters, media
     and copy share the same left edge, 35/35 headings, and the collapse toggle
     reads as a 23px bold "Ver datos →" row. */
  @media screen and (max-width: 749px) {
    :is(
[id$='__results_luxlight'],
    [id$='__technology_luxlight'],
    [id$='__service_luxlight'],
    [id$='__eclat_luxlight'],
    [id$='__wellbeing_hop'],
    [id$='__technology_hop'],
    [id$='__results_hop'],
    [id$='__results_ultra_repair'],
    [id$='__technology_ultra_repair'],
    [id$='__overnight_ultra_repair'],
    [id$='__results_colour_last'],
    [id$='__ferulic_colour_last'],
    [id$='__results_smooth_hydration'],
    [id$='__hyaluronic_smooth_hydration'],
    [id$='__stats_carta_under'],
    [id$='__glucamine_under'],
    [id$='__elevated_warmth_under']
    ) {
      padding-block-start: 15px !important;
      padding-block-end: 15px !important;

      :is(.montibello-stats, .montibello-banner--split, .montibello-feature-rows) {
        max-width: none;
        padding-inline: 15px !important;
        row-gap: 20px;
      }

      :is(.montibello-stats__card, .montibello-feature-rows__content, .montibello-banner__content) {
        padding: 0 !important;
        background: transparent;
      }

      :is(h1, h2, h3) {
        font-size: 35px !important;
        line-height: 35px !important;
      }

      :is(.montibello-stats__media, .montibello-banner__media, .montibello-feature-rows__media) {
        aspect-ratio: 900 / 640 !important;
        border-radius: 12px !important;
      }

      :is(.montibello-feature-rows__toggle-label, .montibello-stats__toggle-label) {
        display: flex;
        width: 100%;
        justify-content: space-between;
        align-items: center;
        font-size: 23px;
        line-height: 21px;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      :is(.montibello-feature-rows__toggle-icon, .montibello-stats__toggle-icon) {
        display: none;
      }

      :is(.montibello-feature-rows__toggle-label, .montibello-stats__toggle-label)::after {
        content: '\2192';
        font-weight: 400;
      }
    }
  }

  /* mobile heroes of the Under / Ultra Repair / Colour Last / Smooth Hydration
     pages are the wide campaign photo as a 390x146 strip on the official site
     (not a tall portrait crop) */
  @media screen and (max-width: 749px) {
    :is(
      [id$='__hero_under'],
      [id$='__hero_ultra_repair'],
      [id$='__hero_colour_last'],
      [id$='__hero_smooth_hydration']
    ) .montibello-banner--full .montibello-banner__media {
      aspect-ratio: 2560 / 960 !important;
      min-height: 0 !important;
    }
  }

  @media screen and (max-width: 749px) {
    /* the footnote belongs to the collapsed data block, like on the official page */
    .montibello-stats__toggle-input:not(:checked) ~ .montibello-stats__data .montibello-stats__footnote {
      display: none;
    }
  }
{% endstylesheet %}


{%- comment -%}
  Editorial card for the Magazine rail. Uses the SAME official Hair Magazine
  article images and titles the live reference currently publishes
  (downloaded from hair.montibello.com) where the article is relevant to a
  confirmed Peru range or general professional education — not a fabricated
  blog post with an invented author/date.
{%- endcomment -%}

{%- assign magazine_card_link = block.settings.link | default: '#' -%}
{%- if magazine_card_link contains '/pages/magazine' and pages['magazine'].handle != 'magazine' -%}{%- assign magazine_card_link = '#hair-magazine' -%}{%- endif -%}
<a href="{{ magazine_card_link }}" class="montibello-magazine-card" {{ block.shopify_attributes }}>
  <div class="montibello-magazine-card__media">
    {% if block.settings.bundled_image != blank %}
      <img
        src="{{ block.settings.bundled_image | asset_url }}"
        alt="{{ block.settings.title | escape }}"
        loading="lazy"
        class="montibello-magazine-card__image"
        width="606"
        height="772"
      >
    {% endif %}
    <div class="montibello-magazine-card__scrim"></div>
    <div class="montibello-magazine-card__caption">
      {% if block.settings.title != blank %}
        <div class="montibello-magazine-card__title">{{ block.settings.title }}</div>
      {% endif %}
      {% if block.settings.text != blank %}
        <div class="montibello-magazine-card__text">{{ block.settings.text }}</div>
      {% endif %}
    </div>
  </div>
</a>

{% stylesheet %}
  .montibello-magazine-card {
    display: block;
    flex: 0 0 312px;
    width: 312px;
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    .montibello-magazine-card {
      flex-basis: 285px;
      width: 285px;
    }
  }

  .montibello-magazine-card__media {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 312 / 397;
  }

  .montibello-magazine-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .montibello-magazine-card:hover .montibello-magazine-card__image {
    transform: scale(1.03);
  }

  .montibello-magazine-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 50%);
  }

  .montibello-magazine-card__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 18px 20px;
    color: #FFFFFF;
  }

  .montibello-magazine-card__title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  @media screen and (min-width: 750px) {
    .montibello-magazine-card__title {
      font-size: 23px;
      line-height: 1.15;
    }
  }

  .montibello-magazine-card__text {
    display: none;
    margin-top: 4px;
    font-size: 13px;
    opacity: 0.85;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tarjeta de Magazine",
  "settings": [
    {
      "type": "text",
      "id": "bundled_image",
      "label": "Nombre de archivo en /assets",
      "default": "montibello-under-editorial-elevated-warmth.jpg"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Under"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texto breve"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    }
  ],
  "presets": [
    {
      "name": "Tarjeta de Magazine"
    }
  ]
}
{% endschema %}

{%- comment -%}
  Single gallery image for the UNDER campaign carousel. Renders a bundled
  Montibello asset (official campaign photography, downloaded locally) the
  same way montibello-image-banner.liquid does, cropped to a consistent
  portrait frame via object-fit so a landscape source and a portrait source
  sit in the same rhythm — matching the official gallery's uniform portrait
  crop without pre-cropping the source files themselves.
{%- endcomment -%}

{% liquid
  assign bundled_width = 933
  assign bundled_height = 1400
  case block.settings.bundled_image
    when 'montibello-under-gallery-01.jpg'
      assign bundled_width = 1400
      assign bundled_height = 933
    when 'montibello-under-gallery-03.jpg'
      assign bundled_width = 600
      assign bundled_height = 839
    when 'montibello-under-gallery-07.jpg'
      assign bundled_width = 1400
      assign bundled_height = 933
    when 'montibello-under-gallery-08.jpg'
      assign bundled_width = 600
      assign bundled_height = 839
  endcase
%}

<div class="montibello-gallery-image" {{ block.shopify_attributes }}>
  {% if block.settings.bundled_image != blank %}
    <img
      src="{{ block.settings.bundled_image | asset_url }}"
      alt="{{ block.settings.alt | escape }}"
      loading="lazy"
      width="{{ bundled_width }}"
      height="{{ bundled_height }}"
      class="montibello-gallery-image__img"
    >
  {% endif %}
</div>

{% stylesheet %}
  .montibello-gallery-image {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 4px;
  }

  .montibello-gallery-image__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Imagen de galería",
  "settings": [
    {
      "type": "text",
      "id": "bundled_image",
      "label": "Nombre de archivo en /assets"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Texto alternativo"
    }
  ]
}
{% endschema %}

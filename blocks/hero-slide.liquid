{%- comment -%}
  One slide of the Montibello HOME hero slider. Carries its own bundled
  campaign image (native theme asset, not an Admin-uploaded file) plus an
  optional small sub-range logo lockup (matching the reference's per-slide
  "under"/"luxlight"/"hop" logo above the headline), heading, text and CTA.
{%- endcomment -%}

<div class="montibello-hero-slide" {{ block.shopify_attributes }}>
  {% if block.settings.bundled_image != blank %}
    <img
      src="{{ block.settings.bundled_image | asset_url }}"
      alt="{{ block.settings.image_alt | escape }}"
      loading="lazy"
      class="montibello-hero-slide__image"
      width="2560"
      height="960"
    >
  {% endif %}

  <div class="montibello-hero-slide__content">
    {% if block.settings.logo_image != blank %}
      <img
        src="{{ block.settings.logo_image | asset_url }}"
        alt="{{ block.settings.range_name | escape }}"
        loading="lazy"
        class="montibello-hero-slide__logo"
        width="120"
        height="34"
      >
    {% elsif block.settings.range_name != blank %}
      <div class="montibello-hero-slide__logo montibello-hero-slide__logo--text">{{ block.settings.range_name }}</div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="montibello-hero-slide__heading">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.text != blank %}
      <p class="montibello-hero-slide__text">{{ block.settings.text }}</p>
    {% endif %}
    {% if block.settings.button_label != blank %}
      <a href="{{ block.settings.button_link | default: '#' }}" class="montibello-hero-slide__cta">{{ block.settings.button_label }}</a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .montibello-hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease;
  }

  .montibello-hero-slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* No-JS / pre-hydration fallback: show the first slide until the slider
     script attaches (which adds .js-hero-ready and takes over via
     .is-active). Liquid can't reach for `forloop` from inside an
     individually-rendered block, so this is done in CSS instead. Each
     block is wrapped by Shopify in its own .shopify-block div, so
     ":first-child" must be scoped to that wrapper rather than to
     .montibello-hero-slide itself (which is always its wrapper's only
     child). */
  .montibello-hero-slider:not(.js-hero-ready) .montibello-hero-slider__track > .shopify-block:first-child .montibello-hero-slide {
    opacity: 1;
    visibility: visible;
  }

  .montibello-hero-slide__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .montibello-hero-slide__content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    color: #FFFFFF;
    padding: 1.75rem 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .montibello-hero-slide__content {
      padding-block: 3rem;
      padding-inline: 30px;
    }
  }

  .montibello-hero-slide__logo {
    display: block;
    height: 31px;
    width: auto;
    margin-bottom: 12px;
  }

  .montibello-hero-slide__logo--text {
    font-family: var(--font-accent--family);
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: lowercase;
    letter-spacing: -0.01em;
  }

  .montibello-hero-slide__heading {
    margin: 0 0 12px;
    font-weight: 700;
    line-height: 1.1;
    /* Reference heading tracks tight (-3% on TT Commons). Montserrat renders
       wider than TT Commons at the same nominal size, so the same negative
       tracking here also helps compensate for that extra visual width. */
    letter-spacing: -0.02em;
  }

  @media screen and (min-width: 750px) {
    .montibello-hero-slide__heading {
      max-width: 417px;
      font-size: 40px;
      line-height: 40px;
    }
  }

  .montibello-hero-slide__text {
    margin: 0 0 16px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    opacity: 0.9;
  }

  @media screen and (min-width: 750px) {
    .montibello-hero-slide__text {
      max-width: 417px;
      font-size: 16px;
      line-height: 20px;
    }
  }

  .montibello-hero-slide__cta {
    display: inline-block;
    color: #FFFFFF;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media screen and (min-width: 750px) {
    .montibello-hero-slide__cta {
      /* Reference CTA ("Ver gama") renders at 23px/600 — visually
         subordinate to the 40px heading but clearly larger than a small
         text link. */
      font-size: 23px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Diapositiva de héroe",
  "settings": [
    {
      "type": "text",
      "id": "bundled_image",
      "label": "Nombre de archivo en /assets",
      "default": "montibello-under-hero-desktop.jpg"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo de la imagen"
    },
    {
      "type": "text",
      "id": "logo_image",
      "label": "Logo de gama (nombre de archivo en /assets, opcional)"
    },
    {
      "type": "text",
      "id": "range_name",
      "label": "Nombre de la gama (usado si no hay logo)",
      "default": "Under"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Descubre Elevated Warmth"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Ver gama"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    }
  ],
  "presets": [
    {
      "name": "Diapositiva de héroe"
    }
  ]
}
{% endschema %}

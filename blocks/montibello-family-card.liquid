{%- comment -%}
  One range card for montibello-family-grid.liquid (e.g. "Ultra Repair" /
  "Colour Last" / "Smooth Hydration" under HOP's "Gamas Hop"). Links to a
  collection, not a product — bodegón family image + bold title + a
  "Ver productos" link with a trailing arrow, matching the reference.
{%- endcomment -%}

<a href="{{ block.settings.link | default: '#' }}" class="montibello-family-card" {{ block.shopify_attributes }}>
  <div class="montibello-family-card__media">
    {% if block.settings.image != blank %}
      {{
        block.settings.image
        | image_url: width: 1200
        | image_tag: loading: 'lazy', widths: '400,600,900,1200', class: 'montibello-family-card__image'
      }}
    {% elsif block.settings.bundled_image != blank %}
      <img
        src="{{ block.settings.bundled_image | asset_url }}"
        alt="{{ block.settings.title | escape }}"
        loading="lazy"
        class="montibello-family-card__image"
        width="2560"
        height="1187"
      >
    {% endif %}
  </div>
  <p class="montibello-family-card__title">{{ block.settings.title }}</p>
  <span class="montibello-family-card__link">
    {{ block.settings.link_label | default: 'Ver productos' }}
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>

{% schema %}
{
  "name": "Tarjeta de gama",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen personalizada (opcional)"
    },
    {
      "type": "text",
      "id": "bundled_image",
      "label": "Imagen incluida (nombre de archivo en assets/)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace",
      "default": "Ver productos"
    }
  ]
}
{% endschema %}

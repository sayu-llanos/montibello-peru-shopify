{%- comment -%}
  Image + range name + short descriptor, no price/SKU — used while the real
  Shopify product catalog is prepared separately.
{%- endcomment -%}

<a href="{{ block.settings.link | default: '#' }}" class="montibello-product-teaser-card" {{ block.shopify_attributes }}>
  <div class="montibello-product-teaser-card__media">
    {% if block.settings.bundled_image != blank %}
      <img
        src="{{ block.settings.bundled_image | asset_url }}"
        alt="{{ block.settings.title | escape }}"
        loading="lazy"
        class="montibello-product-teaser-card__image"
        width="800"
        height="1000"
      >
    {% endif %}
  </div>
  {% if block.settings.title != blank %}
    <div class="montibello-product-teaser-card__title">{{ block.settings.title }}</div>
  {% endif %}
  {% if block.settings.text != blank %}
    <div class="montibello-product-teaser-card__text">{{ block.settings.text }}</div>
  {% endif %}
</a>

{% stylesheet %}
  .montibello-product-teaser-card {
    display: block;
    flex: 0 0 283px;
    width: 283px;
    color: inherit;
    text-decoration: none;
  }

  .montibello-product-teaser-card__media {
    aspect-ratio: 283 / 394;
    overflow: hidden;
    border-radius: 5px;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px;
  }

  .montibello-product-teaser-card__image {
    display: block;
    width: 100%;
    height: 100%;
    /* Real product packshots (transparent PNG, varied native ratios) must
       show the whole product like a real PDP packshot — object-fit: cover
       would crop bottles/tubes unpredictably depending on their aspect
       ratio. */
    object-fit: contain;
  }

  .montibello-product-teaser-card__title {
    margin-top: 16px;
    font-size: 18px;
    font-weight: 700;
  }

  .montibello-product-teaser-card__text {
    margin-top: 4px;
    font-size: 14px;
    color: var(--color-foreground, #2E2D2C);
    opacity: 0.75;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tarjeta de producto",
  "settings": [
    {
      "type": "text",
      "id": "bundled_image",
      "label": "Nombre de archivo en /assets",
      "default": "montibello-under-product-colorant.webp"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Nombre",
      "default": "Under"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Descripción breve"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    }
  ],
  "presets": [
    {
      "name": "Tarjeta de producto"
    }
  ]
}
{% endschema %}

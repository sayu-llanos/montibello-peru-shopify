{
  "sections": {
    "hero_intro_ultra_repair": {
      "type": "section",
      "blocks": {
        "intro_group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "gap": 16,
            "width": "custom",
            "custom_width": 50,
            "width_mobile": "fill",
            "height": "fit"
          },
          "blocks": {
            "heading": {
              "type": "text",
              "settings": {
                "text": "<h1>Ultra Repair</h1>",
                "type_preset": "h1",
                "max_width": "none"
              }
            },
            "text": {
              "type": "text",
              "settings": {
                "text": "<p>Reconstruye, fortalece, repara y protege para conseguir un cabello más fuerte y resistente. Con Colágeno Vegano y LifeAlgae Bioscience.</p>",
                "type_preset": "rte",
                "max_width": "none"
              }
            }
          },
          "block_order": [
            "heading",
            "text"
          ]
        }
      },
      "block_order": [
        "intro_group"
      ],
      "name": "Sección",
      "settings": {
        "section_width": "page-width",
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 40,
        "padding-block-end": 40
      }
    },
    "product_range_ultra_repair": {
      "type": "montibello-product-range",

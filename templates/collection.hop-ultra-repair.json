            "type_preset": "h2",
            "alignment": "center",
            "width": "100%"
          }
        },
        "card_1": {
          "type": "product-grid-card",
          "settings": {
            "product": "gid://shopify/Product/11075616702657",
            "fallback_title": "HOP Ultra Repair Shampoo"
          }
        },
        "card_2": {
          "type": "product-grid-card",
          "settings": {
            "product": "gid://shopify/Product/11077066916033",
            "fallback_title": "HOP Ultra Repair Rinse"
          }
        },
        "card_3": {
          "type": "product-grid-card",
          "settings": {
            "product": "gid://shopify/Product/11077066883265",
            "fallback_title": "HOP Ultra Repair Mask"
          }
        },
        "card_4": {
          "type": "product-grid-card",
          "settings": {
            "product": "gid://shopify/Product/11077066981569",
            "fallback_title": "HOP Ultra Repair Sealed Ends"
          }
        }
      },
      "block_order": [
        "heading",
        "card_1",
        "card_2",
        "card_3",
        "card_4"

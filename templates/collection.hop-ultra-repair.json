      "name": "Gama de productos Montibello",
      "settings": {
        "section_width": "page-width",
        "placeholder_note": "Catálogo completo disponible próximamente en Montibello Perú.",
        "padding-block-start": 64,
        "padding-block-end": 64
      }
    },
    "cta_professional_ultra_repair": {
      "type": "section",
      "blocks": {
        "group_row": {
          "type": "group",
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": true,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "center",
            "gap": 32
          },
          "blocks": {
            "group_professional": {
              "type": "group",
              "settings": {
                "content_direction": "row",
                "vertical_on_mobile": true,
                "vertical_alignment": "center",
                "gap": 24,
                "width": "fill"
              },
              "blocks": {
                "heading": {
                  "type": "text",
                  "settings": {
                    "text": "<p>¿Tienes un salón pero no eres cliente todavía?</p>",
                    "type_preset": "h5",
                    "text_color": "#FFFFFF",
                    "max_width": "normal"
                  }
                },
                "button": {
                  "type": "button",
                  "settings": {
                    "label": "Contacta con un comercial",
                    "link": "/pages/contacto",
                    "style_class": "button-custom",
                    "custom_button_background": "rgba(0,0,0,0)",
                    "custom_button_text": "#FFFFFF",
                    "custom_button_border": "#FFFFFF"
                  }
                }
              },
              "block_order": [
                "heading",
                "button"
              ]
            },
            "group_locator": {
              "type": "group",
              "settings": {
                "content_direction": "row",
                "vertical_on_mobile": true,
                "vertical_alignment": "center",
                "gap": 24,
                "width": "fill"

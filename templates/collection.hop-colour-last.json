        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "ferulic_colour_last": {
      "type": "montibello-image-banner",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>LifeAlgae Bioscience + Ácido Ferúlico</h2>",
            "type_preset": "h2",
            "max_width": "normal",
            "padding-block-end": 12
          }
        },
        "text_1": {
          "type": "text",
          "settings": {
            "text": "<p>Combinación de algas que amplifica y potencia las moléculas activas, sus efectos se multiplican x4 permitiendo actuar sobre cuero cabelludo y cabello.</p>",
            "type_preset": "rte",
            "max_width": "normal"
          }
        },
        "text_2": {
          "type": "text",
          "settings": {
            "text": "<p>Ácido Ferúlico: un potente antioxidante de origen vegetal con un alto poder hidratante que protege y prolonga el color y el brillo, y con una capacidad protectora que neutraliza los daños procedentes de la radiación solar.</p>",
            "type_preset": "rte",
            "max_width": "normal"
          }
        },
        "text_3": {
          "type": "text",
          "settings": {
            "text": "<p>Filtro UV: protege contra las agresiones provocadas por el sol y la polución.</p>",
            "type_preset": "rte",
            "max_width": "normal"
          }
        }
      },
      "block_order": ["heading", "text_1", "text_2", "text_3"],
      "name": "Banner Montibello",
      "settings": {
        "layout": "split",
        "media_position": "right",
        "section_width": "full-width",
        "bundled_image": "montibello-hop-colour-last-ferulic.webp",
        "image_alt": "Ácido Ferúlico — Montibello HOP Colour Last",
        "toggle_overlay": false,
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },

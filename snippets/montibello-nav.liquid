{%- doc -%}
  Peru mega-menu data + renderers (single source of truth for desktop and mobile).

  @param {string} mode - 'panel' (desktop mega panel) or 'drawer' (mobile accordion)
  @param {string} key - 'color' or 'tratamiento'
{%- enddoc -%}

{%- liquid
  # Format: columns split by '##'; column = 'HEADING::item|url;item|url'.
  # SINGLE SOURCE OF TRUTH for the Peru nav (desktop panels + mobile drawer).
  # 7 category destinations below are real Shopify collections (not /pages/).
  # 'VER TODO COLOR' still points at the /pages/color landing page (separate task).
  # Never use '#'.
  case key
    when 'color'
      assign title = 'COLOR'
      assign all_label = 'VER TODO COLOR'
      assign all_url = '/pages/color'
      assign data = 'GAMA::UNDER|/collections/under;LUXLIGHT|/collections/luxlight##TIPO DE COLORACIÓN::COLORACIÓN ALTA COBERTURA|/collections/coloracion-alta-cobertura;DECOLORACIÓN|/collections/decoloracion;TRATAMIENTO ANTI ROTURA|/collections/tratamiento-anti-rotura'
    when 'tratamiento'
      assign title = 'TRATAMIENTO'
      assign all_label = 'VER TODO TRATAMIENTO'
      assign all_url = '/collections/hop'
      assign data = 'GAMA::HOP|/collections/hop##NECESIDADES::REPARACIÓN|/collections/hop-ultra-repair;MANTENIMIENTO DEL COLOR|/collections/hop-colour-last;HIDRATACIÓN|/collections/hop-smooth-hydration##TIPO DE PRODUCTO::CHAMPÚ|/collections/champu;MASCARILLA|/collections/mascarilla;ACONDICIONADOR / RINSE|/collections/acondicionador;TRATAMIENTO DE PUNTAS|/collections/tratamiento-de-puntas'
  endcase
  assign columns = data | split: '##'
-%}

{%- if mode == 'panel' -%}
  <div
    class="montibello-mega"
    id="montibello-mega-{{ key }}"
    data-mega-panel="{{ key }}"
    role="region"
    aria-label="{{ title }}"
    hidden
  >
    <div class="montibello-mega__inner montibello-mega__inner--cols-{{ columns.size }}">
      {%- for column in columns -%}
        {%- assign parts = column | split: '::' -%}
        <div class="montibello-mega__col">
          <p class="montibello-mega__heading">{{ parts[0] }}</p>
          <ul class="montibello-mega__list" role="list">
            {%- assign items = parts[1] | split: ';' -%}
            {%- for item in items -%}
              {%- assign pair = item | split: '|' -%}
              <li><a class="montibello-mega__link" href="{{ pair[1] }}">{{ pair[0] }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- else -%}
  <li class="menu-drawer__list-item--flat menu-drawer__list-item--divider montibello-drawer-item">
    <details class="montibello-drawer-details" data-mega-drawer>
      <summary class="menu-drawer__menu-item montibello-drawer-summary">
        <span class="menu-drawer__menu-item-text wrap-text">{{ title }}</span>
        <span class="montibello-drawer-icon" aria-hidden="true"></span>
      </summary>
      <div class="montibello-drawer-groups">
        {%- for column in columns -%}
          {%- assign parts = column | split: '::' -%}
          <details class="montibello-drawer-group" data-mega-drawer-group>
            <summary class="montibello-drawer-group__summary">
              <span>{{ parts[0] }}</span>
              <span class="montibello-drawer-icon" aria-hidden="true"></span>
            </summary>
            <ul class="montibello-drawer-group__list" role="list">
              {%- assign items = parts[1] | split: ';' -%}
              {%- for item in items -%}
                {%- assign pair = item | split: '|' -%}
                <li><a class="montibello-drawer-group__link" href="{{ pair[1] }}">{{ pair[0] }}</a></li>
              {%- endfor -%}
            </ul>
          </details>
        {%- endfor -%}
        <a class="montibello-drawer-all" href="{{ all_url }}">{{ all_label }}</a>
      </div>
    </details>
  </li>
{%- endif -%}

{% stylesheet %}
  /* ---------- Desktop mega panel ---------- */
  .montibello-mega {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .header__row--top { position: relative; }

    .montibello-mega:not([hidden]) {
      display: block;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      z-index: 20;
      background: #fff;
      color: #1a1a1a;
      border-top: 1px solid #e8e6e1;
      box-shadow: 0 24px 40px -28px rgb(0 0 0 / 0.35);
      animation: montibello-mega-in 0.18s ease-out;
    }

    .montibello-mega__inner {
      display: grid;
      grid-template-columns: repeat(var(--cols, 2), minmax(0, 320px));
      column-gap: clamp(3rem, 7vw, 7rem);
      max-width: 1400px;
      margin-inline: auto;
      padding: 3rem 30px 3.5rem;
    }
    .montibello-mega__inner--cols-2 { --cols: 2; }
    .montibello-mega__inner--cols-3 { --cols: 3; }

    .montibello-mega__heading {
      margin: 0 0 1.25rem;
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #8a8780;
    }

    .montibello-mega__list {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .montibello-mega__link {
      display: inline-block;
      font-size: 0.9375rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: inherit;
      text-decoration: none;
      background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
      transition: background-size 0.2s ease;
    }
    .montibello-mega__link:hover,
    .montibello-mega__link:focus-visible {
      background-size: 100% 1px;
    }

    /* Active top-level underline */
    .menu-list__link[data-mega-trigger] {
      position: relative;
      cursor: pointer;
    }
    .menu-list__link[data-mega-trigger]::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      bottom: -6px;
      height: 2px;
      background: currentColor;
      transform: scaleX(0);
      transition: transform 0.2s ease;
    }
    .menu-list__link[data-mega-trigger][aria-expanded='true']::after {
      transform: scaleX(1);
    }
  }

  @keyframes montibello-mega-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .montibello-mega:not([hidden]) { animation: none; }
  }

  /* ---------- Mobile drawer accordion ---------- */
  .montibello-drawer-item { list-style: none; }

  .montibello-drawer-details > summary,
  .montibello-drawer-group > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }
  .montibello-drawer-details > summary::-webkit-details-marker,
  .montibello-drawer-group > summary::-webkit-details-marker { display: none; }

  .montibello-drawer-icon {
    position: relative;
    flex: none;
    width: 12px;
    height: 12px;
  }
  .montibello-drawer-icon::before,
  .montibello-drawer-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.2s ease;
  }
  .montibello-drawer-icon::after { transform: rotate(90deg); }
  details[open] > summary > .montibello-drawer-icon::after { transform: rotate(0); }

  .montibello-drawer-groups { padding: 0 0 0.75rem 0.25rem; }
  .montibello-drawer-all {
    display: block;
    padding: 0.9rem 0 0.4rem;
    border-top: 1px solid rgb(0 0 0 / 0.08);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }

  .montibello-drawer-group { border-top: 1px solid rgb(0 0 0 / 0.08); }
  .montibello-drawer-group__summary {
    padding: 0.9rem 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a8780;
  }
  .montibello-drawer-group__list {
    margin: 0;
    padding: 0 0 0.75rem 0.75rem;
    list-style: none;
  }
  .montibello-drawer-group__link {
    display: block;
    padding: 0.55rem 0;
    font-size: 0.9375rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }
{% endstylesheet %}
